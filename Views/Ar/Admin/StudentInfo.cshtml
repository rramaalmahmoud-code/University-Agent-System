@model University_Agent_System.Models.ViewModel.StudentInfoViewModel
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims


@functions {
    public string GetUserType()
    {
        var jwt = Context.Request.Cookies["jwt"];
        if (string.IsNullOrEmpty(jwt)) return null;

        var handler = new JwtSecurityTokenHandler();
        var token = handler.ReadJwtToken(jwt);
        var typeClaim = token.Claims.FirstOrDefault(c => c.Type == "userType");
        return typeClaim?.Value;
    }
}

@{
    string userType = GetUserType();
}
@{
    Layout = "_LayoutAdminAr";

}

@{
    bool isAccepted = Model.Status == "مقبول";
    bool isRejected = Model.Status == "مرفوض";
    bool isPinding = Model.Status == "	قيد التنفيذ" || string.IsNullOrEmpty(Model.Status);
    bool hasCondition = Model.Status == "مقبول بشرط";
    bool isSuperAdmin = User.IsInRole("Super Admin");
    bool isAdmin = User.IsInRole("Admin");
    bool isApproved = Model.studentApproval == 1;
    // bool allowAction = isSuperAdmin || (isAdmin && isApproved);
    bool allowAction = isSuperAdmin || isAdmin ;

}
<main>
    <div class="container-fluid padding margin">

        <div class="row">
            <div class="col-lg-12">
