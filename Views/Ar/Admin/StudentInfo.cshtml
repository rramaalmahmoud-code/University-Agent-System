                    <div class="lineright" style="display: block; background-color: #DAA328; "></div>
                </section>


                <div class="row g-5">
                    <div class="col-lg-3"></div>
                    <div class="col-lg-6">
                        <p class="read" style="position: relative; top: 25px; ">
                            الحالة: <span style="color: #daa328;">@Model.isActive</span>
                        </p>


                        <div style="
    display: flex;
    justify-content: end;
    gap: 10px;
    padding-bottom: 10px;
">

                            @if (!isAccepted)
                            {
                                <a href="@Url.Action("EditStudent", "Ar", new { studentId = Model.studentId })" style="  color: #264C9F; z-index: 1; ">
                                    <i class="fa-solid fa-pen-to-square"></i>تعديل</a>

                           
                            }
                            @if (userType != "Admin") // 👈 hide link if user is Admin
                            {
                              
                                <a href="@Url.Action("DeleteStudent", "AdminAr", new { id = Model.studentId })" style="color: #264C9F;  z-index: 1;">
                                    <i class="fa-solid fa-trash"></i>حذف</a>


                            }




                        </div>





                        <div class="cardcontainer">
                            <div class="card card10" style="border-top: 4px solid #252486; ">
