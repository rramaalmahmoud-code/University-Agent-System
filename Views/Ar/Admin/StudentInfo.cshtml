                                }
                                <div class="card-body">
                              
                               

                                    <div class="card-text">
                                            <h2 class="heading14">@Model.studentNameArabic</h2>
                                        <div>
                                            <label class="read">الموافقة من الطالب:</label>
                                                <label class="read">@Model.isApproved</label>
                                        </div>
                                        <div class="rowspacing"></div>
                                        <div>
                                            <label class="normal">الرقم الوطني:</label>
                                                <label class="read" style="color: #daa328">@Model.nationalId</label>
                                        </div>
                                        <div>
                                            <label class="normal">الجنسية:</label>
                                                <label class="normal">@Model.Nationality</label>
                                        </div>
                                        <div>
                                                <label class="normal">@Model.Country-@Model.city</label>

                                        </div>
                                        <div>
                                            <label class="normal">رقم الهاتف:</label>
                                                <label class="normal">@Model.studentPhone</label>
                                        </div>
                                        <div class="rowspacing"></div>
                                        <div>
                                                <label class="read">@Model.Degree -@Model.Faculty_Name </label>

                                        </div>
                                        <div>
                                                <label class="read">@Model.Major_Name</label>

                                        </div>
                                        <div class="partspacing"></div>
                                        <div>
                                                <label class="read">@Model.Semester</label>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="Emailnphone">
                            <div class="Email2">
                                    <div style="" class="Emailtext2"><p>@Model.studentEmail</p></div>
                            </div>
                            <div class="phone2">
                                    <div style="" class="phonetext2"><p>@Model.studentCode</p></div>
                            </div>
                        </div>

                    </div>
                    <div class="col-lg-3"></div>
                </div>

            </div>
        </div>
      
        <div class="container-fluid padding margin">
                <div class="row">
                    <div class="col-lg-2"></div>
                    <div class="col-lg-8">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr style="background: #ecebea">
                                    <th>اسم الملف</th>
                                    <th>الملف</th>
                                    <th>تاريخ التحميل</th>
                                    <th>الفعل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Files != null && Model.Files.Any())
                                {
                                    foreach (var file in Model.Files)
                                    {
                                        <tr>
                                            <td>@file.Title</td>
                                            <td>@file.FileName</td>
                                            <td>@file.UploadedDate</td>
                                            <td><a href="@file.FileUrl" target="_blank">عرض...</a></td>
                                        </tr>
                                    }
                                }
