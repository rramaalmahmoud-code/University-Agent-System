                    <!-- Approve Button -->
                       @*  <button type="submit" class="mybtn heading15" style="background-color: #daa328; width: 100%; text-align: center; border: none;">
                                @(isAccepted
                                    ? (hasCondition ? "✔ مقبول بشرط" : "✔ مقبول")
                                    : "قبول")
                    </button> *@
                        <button type="submit"
                                class="mybtn heading15"
                                style="background-color: #daa328; width: 100%; text-align: center; border: none;"
                                @(allowAction ? "" : "disabled")>
                            @(isAccepted
                                                        ? (hasCondition ? "✔ مقبول بشرط" : "✔ مقبول")
                                                        : "قبول")
                        </button>
                        </form>

                    <form asp-controller="AdminAr" asp-action="UpdateStatus" method="post" style="width: 50%;">
                        <input type="hidden" name="studentId" value="@Model.studentId" />
