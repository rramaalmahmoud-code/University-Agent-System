                                </div>
                            <!-- مربع نص رقم الهاتف -->
                            <div class="col-lg-8" style="padding-right: 8px">
                                    <input type="text" class="form-control" id="phone" placeholder="" name="agentPhone" value="@Model.agentPhone">
                                    <span asp-validation-for="agentPhone" class="text-danger"></span>
                                </div>
                        </div>
                    </div>
 *@    
