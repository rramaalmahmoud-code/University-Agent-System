@using University_Agent_System.Models
@using University_Agent_System.Models.ViewModel
@model AgentViewModel
@{
    Layout = "_LayoutAdminAr";
    var nationalities = (List<University_Agent_System.Models.nationality>)Model.Nationalities;
    var countries = (List<University_Agent_System.Models.country>)Model.Countries;
    var selectedNationality = nationalities?.FirstOrDefault(n => n.nationalityId == Model.nationalityId)?.nationalityArabic;
    var selectedCountry = countries?.FirstOrDefault(c => c.countryId == Model.countryId)?.countryArabic;
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}
<main>
    <div class="container-fluid padding margin" style="background:#d0d0cf">

        <div class="row">
            <!---------------إضافة وكيل جديد---------------->
            <div class="col-lg-12">
                <section id="title-wrapper" style=" justify-content: End;">

                    <h1 class="sectiontitle heading7"><p style="text-align: center;"><span style="color: #252468;">تحديث بيانات الوكيل</span></p></h1>
                    <div class="lineright" style="display: block; background-color: #DAA328; "></div>
                </section>

                <div class="partspacing"></div>
                <div class="row">
                    <dikv class="col-lg-12">
                        <h2 class="heading14">معلومات الوكيل</h2>
                    </dikv>
                </div>
                    <form action="EditAgent" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="agentId" value="@Model.agentId" />

                <div class="partspacing"></div>


                    <div class="row">
                        <div class="col-lg-6">
                            <div class="row g-0">
                                <div class="col-lg-4">
                                    <label for="AgentNameEnglish" class="form-label heading16 labelspacing">اسم الوكيل بالانجليزي:<span style="color:red">*</span></label>
                                </div>
                                <!------------------- AgentName/textBox-------------->
                                <div class="col-lg-8" style="padding-left:8px">
                                    <input asp-for="agentNameEnglish" type="text" class="form-control " id="AgentName" placeholder="" name="agentNameEnglish" dir="ltr">

                                    <span asp-validation-for="agentNameEnglish" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- AgentName/label-->
                        <div class="col-lg-6">
                            <div class="row g-0">
                                <div class="col-lg-4">
                                    <label for="AgentName" class="form-label heading16 labelspacing">اسم الوكيل بالعربي: <span style="color:red">*</span></label>
                                </div>
                                <!------------------- AgentName/textBox-------------->
                                <div class="col-lg-8" style="padding-left:8px">
                                    <input type="text" class="form-control " id="AgentName" placeholder="" name="agentNameArabic" value="@Model.agentNameArabic">
                                    <span asp-validation-for="agentNameEnglish" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                     

                    </div>
                <div class="rowspacing"></div>
                <div class="row">
                        <!--agentcode-->
                        <div class="col-lg-6">
                            <div class="row g-0">
                                <div class="col-lg-4">
                                    <label for="AgentCode" class="form-label heading16 labelspacing">كود الوكيل: <span style="color:red">*</span></label>
                                </div>
                                <!------------------- AgentCode/textBox-------------->
                                <div class="col-lg-8" style="padding-left:8px">
                                    <input type="text" class="form-control " id="AgentCode" placeholder="" name="agentCode" value="@Model.agentCode" oninput="validateAgentCode(this)">
                                    <span asp-validation-for="agentCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                </div>
                    <script>
                                          function validateAgentCode(input) {

                               
                          const errorSpan = document.getElementById("agentCodeError");

                          if (/[^0-9]/.test(input.value)) {
                            errorSpan.textContent = "Numbers only";
                          } else {
                            errorSpan.textContent = "";
                          }
                        }
                    </script>

                <div class="partspacing"></div>
                <!-- التسمية -->
