                                        <input class="form-control" type="search" value="@selectedNationality" id="recivedGroup" onkeyup="filterNationality()" placeholder="Search Nationality...">
                                        <input type="hidden" asp-for="nationalityId" id="selectedNationalityId" value="@Model.nationalityId" name="nationalityId"> <!-- Hidden input to store nationalityId -->
                                        <span class="input-group-append">
                                        <button class="btn btn-outline-secondary bg-white border-bottom-0 border  ms-n5" type="button">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </span>
                                </div>
                                    <ul id="nationalityOptions" class="list-group mt-2" style="display: none;">
                                        @foreach (var nationality in Model.Nationalities)
                                        {
                                            <li class="list-group-item nationality-item" data-id="@nationality.nationalityId">
                                                @nationality.nationalityArabic
                                            </li>
                                        }
                                    </ul>
                                    <span asp-validation-for="nationalityId" class="text-danger"></span>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="rowspacing"></div>

                <div class="row">
                    <!-- البلد/التسمية -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                    <label for="Country" class="form-label heading16 labelspacing" id="Country_L">البلد:<span style="color:red">*</span></label>
                                </div>
                            <!-- البلد/قائمة منسدلة -->
                            <div class="col-lg-8" style="padding-right: 8px">
                                <div class="input-group">
                                        <input class="form-control" type="search" value="@selectedCountry" id="countrySearch" onkeyup="filterCountry()" placeholder="Search Country...">
                                        <input type="hidden" asp-for="countryId" id="selectedCountryId" name="countryId" value="@Model.countryId"> <!-- Hidden input to store countryId -->
                                        <span class="input-group-append">
                                        <button class="btn btn-outline-secondary bg-white border-bottom-0 border  ms-n5" type="button">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </span>
                                </div>
                                    <ul id="countryOptions" class="list-group mt-2" style="display: none;">

                                        @foreach (var country in Model.Countries)
                                        {
                                            <li class="list-group-item country-item" data-id="@country.countryId">
                                                @country.countryArabic
                                            </li>
                                        }
                                    </ul>
                                    <span asp-validation-for="countryId" class="text-danger"></span>

                            </div>
                        </div>
                    </div>
                    <!-- المدينة / المحافظة -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                    <label for="goverText" class="form-label heading16 labelspacing" id="idNumber_L">المدينة / المحافظة:<span style="color:red">*</span></label>
                                </div>
                            <!-- مربع نص المدينة -->
                            <div class="col-lg-8" style="padding-right: 8px">
                                    <input type="text" class="form-control" id="goverText" placeholder="" name="city" value="@Model.city">
                                    <span asp-validation-for="city" class="text-danger"></span>
                                </div>
                        </div>
                    </div>
                </div>
                <div class="rowspacing"></div>

                <div class="row">
                    <!-- رقم الهاتف -->
@*                     <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
