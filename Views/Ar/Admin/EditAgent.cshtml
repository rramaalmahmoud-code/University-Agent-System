<script>
          function filterCountry() {
           var input, filter, list, items, i, txtValue;
           input = document.getElementById('countrySearch');
           filter = input.value.toUpperCase();
           list = document.getElementById('countryOptions');
           items = list.getElementsByTagName('li');

           // If input is not empty, display the options
           if (input.value.length > 0) {
               list.style.display = "block"; // Show options
           } else {
               list.style.display = "none"; // Hide options when input is empty
           }

           // Loop through all options and hide those that don't match the search
           for (i = 0; i < items.length; i++) {
               txtValue = items[i].textContent || items[i].innerText;
               if (txtValue.toUpperCase().indexOf(filter) > -1) {
                   items[i].style.display = "";
               } else {
                   items[i].style.display = "none";
               }
           }
       }


    // Function to populate the input with the selected option
       document.querySelectorAll('.country-item').forEach(function(item) {
           item.addEventListener('click', function() {
               var countryName = item.innerText;
               var countryId = item.getAttribute('data-id');

               // Populate the input field with the selected country
               document.getElementById('countrySearch').value = countryName;

               // Store the countryId in a hidden input for later use
               document.getElementById('selectedCountryId').value = countryId;

               // Hide the options list
               document.getElementById('countryOptions').style.display = "none";
           });
       });



           function filterNationality() {
                               var input, filter, list, items, i, txtValue;
                               input = document.getElementById('recivedGroup');
                               filter = input.value.toUpperCase();
                               list = document.getElementById('nationalityOptions');
                               items = list.getElementsByTagName('li');

                               // If input is not empty, display the options
                               if (input.value.length > 0) {
                                   list.style.display = "block"; // Show options
                               } else {
                                   list.style.display = "none"; // Hide options when input is empty
                               }

                               // Loop through all options and hide those that don't match the search
                               for (i = 0; i < items.length; i++) {
                                   txtValue = items[i].textContent || items[i].innerText;
                                   if (txtValue.toUpperCase().indexOf(filter) > -1) {
                                       items[i].style.display = "";
                                   } else {
                                       items[i].style.display = "none";
                                   }
                               }
                           }


                       // Function to populate the input with the selected option
                        document.querySelectorAll('.nationality-item').forEach(function(item) {
                            item.addEventListener('click', function() {
                                var nationalityName = item.innerText;
                                var nationalityId = item.getAttribute('data-id');

                                // Populate the input field with the selected nationality
                                document.getElementById('recivedGroup').value = nationalityName;

                                // Store the nationalityId in a hidden input for later use
                                document.getElementById('selectedNationalityId').value = nationalityId;


                                // Hide the options list
                                document.getElementById('nationalityOptions').style.display = "none";
                            });
                        });
  


</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const countrySelect =
            document.getElementById("agentPhoneCountryIso2");

        const localPhoneInput =
            document.getElementById("agentPhoneNational");

        const phoneError =
            document.getElementById("phoneClientError");

        const phonePreview =
            document.getElementById("phonePreview");

        const form =
            localPhoneInput?.closest("form");

        if (!countrySelect ||
            !localPhoneInput ||
            !form) {
            return;
        }

        function clearValidation() {
            countrySelect.setCustomValidity("");
            localPhoneInput.setCustomValidity("");
            phoneError.textContent = "";
        }

        function updatePhonePreview() {
            phonePreview.textContent = "";

            const localNumber =
                localPhoneInput.value.trim();

            const selectedOption =
                countrySelect.options[
                    countrySelect.selectedIndex
                ];

            if (!countrySelect.value || !localNumber) {
                return;
            }

            phonePreview.textContent =
                selectedOption.text +
                " — " +
                localNumber;
        }

        localPhoneInput.addEventListener(
            "input",
            function () {
                // السماح بالأرقام فقط
                this.value =
                    this.value.replace(/\D/g, "");

                clearValidation();
                updatePhonePreview();
            });

        countrySelect.addEventListener(
            "change",
            function () {
                clearValidation();
                updatePhonePreview();
            });

        form.addEventListener(
            "submit",
            function (event) {
                clearValidation();

                if (!countrySelect.value) {
                    event.preventDefault();

                    countrySelect.setCustomValidity(
                        "يرجى اختيار دولة رقم الهاتف."
                    );

                    countrySelect.reportValidity();
                    return;
                }

                const localNumber =
                    localPhoneInput.value.trim();

                if (!localNumber) {
                    event.preventDefault();

                    localPhoneInput.setCustomValidity(
                        "يرجى إدخال رقم الهاتف المحلي."
                    );

                    localPhoneInput.reportValidity();
                    return;
                }

                if (!/^\d+$/.test(localNumber)) {
                    event.preventDefault();

                    localPhoneInput.setCustomValidity(
                        "يجب أن يحتوي رقم الهاتف على أرقام فقط."
                    );

                    phoneError.textContent =
                        "يجب أن يحتوي رقم الهاتف على أرقام فقط.";

                    localPhoneInput.reportValidity();
                    return;
                }
            });

        updatePhonePreview();
    });
</script>