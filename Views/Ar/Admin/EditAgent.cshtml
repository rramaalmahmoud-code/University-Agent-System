                                    <span asp-validation-for="agentEmail" class="text-danger"></span>
                                </div>
                        </div>
                    </div>
                </div>
                <div class="partspacing"></div>
                    <div class="row">

                        <div class="col-lg-6">
                            <div class="row g-0">
                                <div class="col-lg-4">
                                    <label for="commission" class="form-label heading16 labelspacing" id="commission">عمولة الوكيل في العقد</label>
                                </div>
                                <!-- commission TextBox -->
                                <div class="col-lg-8" style="padding-right:8px">
