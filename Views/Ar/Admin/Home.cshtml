 <div class="container-fluid padding margin">
        <div class="row">

            <div class="col-lg-12">
                <h2 class="heading14">الطلبات قيد التنفيذ</h2>
                <table style="background-color: #fff;">

                    <thead class="table-light">
                        <tr style="background: #ecebea">

                            <th>اسم الطالب</th>
                            <th>الكود</th>
                            <th>التخصص</th>
                            <th>اسم الوكيل</th>
                            <th>الحالة</th>
                            <th> </th>

                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var student in Model.PendingStudents)
                        {
                            <tr>

                                <td data-label="Student Name" class="readsub">@student.studentNameArabic</td>
                                <td data-label="Code" class="readsub">@student.studentCode</td>
                                <td data-label="Major" class="readsub">@student.Major_Name</td>
                                <td data-label="Agent Name" class="readsub">@student.agentNameArabic</td>
                                <td data-label="Status" class="status-positive">@student.statusArabic</td>


                                <td data-label="" class="heading16 readsub">

                                    <a href="@Url.Action("StudentInfo", "AdminAr", new { studentId = student.studentId })" target="_blank">المزيد...</a>

                                </td>
                            </tr>
                        }



                    </tbody>
                </table>
                <nav aria-label="Page navigation example">
                    <ul class="pagination" style="justify-content: center; align-items: center;">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Home", new { page = i, search = Model.SearchTerm })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>

            </div>

        </div>
    </div>
</main>
<script>
    function filterAgentHome() {
        var input = document.getElementById('agentSearchHome');
        var filter = (input.value || "").toUpperCase();
        var list = document.getElementById('agentOptionsHome');
        var items = list.getElementsByTagName('li');

        list.style.display = input.value.trim().length > 0 ? "block" : "none";

        for (var i = 0; i < items.length; i++) {
            var txtValue = items[i].textContent || items[i].innerText;
            items[i].style.display = (txtValue.toUpperCase().indexOf(filter) > -1) ? "" : "none";
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var list = document.getElementById('agentOptionsHome');
        var input = document.getElementById('agentSearchHome');
        var form = document.getElementById('homeForm');

        // click select
        list.addEventListener('click', function (e) {
            if (e.target && e.target.matches('.agent-item-home')) {
                var agentName = e.target.getAttribute('data-name') || e.target.innerText;

                // ✅ keep your old backend logic (search by agent name)
                input.value = agentName;

                list.style.display = "none";

                // ✅ auto submit to load students
                form.submit();
            }
        });

        // hide dropdown if click outside
        document.addEventListener('click', function (e) {
            var isInside = input.contains(e.target) || list.contains(e.target);
            if (!isInside) list.style.display = "none";
        });
    });
</script>
