@model University_Agent_System.Models.ViewModel.DashboardHomeViewModel
@using System
@using System.Linq
@using System.Globalization

@{
    Layout = "_LayoutAdminAr";
    ViewData["Title"] = "لوحة تحكم الإدارة";

    Func<string, string> statusClass = value =>
    {
        var status = (value ?? "").Trim().ToLowerInvariant();
        if (status == "approved" || status == "accepted") return "approved";
        if (status == "under review" || status == "review") return "review";
        if (status == "rejected") return "missing";
        return "pending";
    };

    Func<string, string> initials = value =>
    {
        if (string.IsNullOrWhiteSpace(value)) return "NA";
        var words = value.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])));
    };

    Func<string, string> statusText = value =>
    {
        var status = (value ?? "").Trim().ToLowerInvariant();
        if (status == "approved" || status == "accepted") return "مقبول";
        if (status == "under review" || status == "review") return "قيد المراجعة";
        if (status == "rejected") return "مرفوض";
        if (status == "pending") return "معلّق";
        return string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;
    };

    Func<string, string> healthText = value =>
    {
        if (string.Equals(value, "Healthy", StringComparison.OrdinalIgnoreCase)) return "جيد";
        if (string.Equals(value, "Needs Attention", StringComparison.OrdinalIgnoreCase)) return "يحتاج متابعة";
        if (string.Equals(value, "Critical", StringComparison.OrdinalIgnoreCase)) return "حرج";
        return value;
    };

    var criticalAlerts = Model.Notifications.Count(x => x.Type == "Critical");
    var warningAlerts = Model.Notifications.Count(x => x.Type == "Warning");
    var attentionAgents = Model.AgentStatistics.Count(x => x.HealthStatus != "Healthy");
    var topAgents = Model.AgentStatistics.OrderByDescending(x => x.ApprovalRate)
        .ThenByDescending(x => x.TotalStudents).Take(4).ToList();
    var pendingTotalPages = Math.Max(
        1,
        (int)Math.Ceiling(Model.PendingTotalCount / (double)Model.PageSize));

    var pendingFromPage = Math.Max(1, Model.CurrentPage - 2);
    var pendingToPage = Math.Min(pendingTotalPages, Model.CurrentPage + 2);

    var pendingFirstRow = Model.PendingTotalCount == 0
        ? 0
        : ((Model.CurrentPage - 1) * Model.PageSize) + 1;

    var pendingLastRow = Math.Min(
        Model.CurrentPage * Model.PageSize,
        Model.PendingTotalCount);
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-dashboard-ar.css" asp-append-version="true" />

<div class="admin-dashboard" dir="rtl" lang="ar">
    <section class="admin-dashboard-page-head">
        <div class="admin-dashboard-title-wrap">
            <h1>لوحة تحكم الإدارة</h1>
            <div class="admin-dashboard-title-line"></div>
            <p>نظرة شاملة على الوكلاء والطلاب والطلبات والموافقات.</p>
        </div>
        <div class="admin-dashboard-today"><i class="far fa-calendar"></i> @DateTime.Now.ToString("dddd، dd MMMM yyyy", new CultureInfo("ar-JO"))</div>
    </section>

    <main class="admin-dashboard-main">
        <form method="get"
              action="@Url.Action("Home", "AdminAr")"
              data-dashboard-filter-url="@Url.Action("Home", "AdminAr")"
              id="dashboardFilterForm"
              class="admin-dashboard-toolbar">
            <div class="admin-dashboard-search">
                <i class="fas fa-search"></i>
                <input name="search"
                       id="dashboardSearchInput"
                       value="@Model.SearchTerm"
                       type="search"
                       placeholder="ابحث باسم الطالب أو الرقم أو التخصص أو الحالة أو الوكيل..."
                       autocomplete="off" />
            </div>
            <select name="intake"
                    id="dashboardIntakeSelect"
                    aria-label="الفصل الأكاديمي">
                @if (Model.IntakeFilter == "current")
                {
                    <option value="current" selected>الفصل الحالي </option>
                }
                else
                {
                    <option value="current">الفصل الحالي </option>
                }
                @if (Model.IntakeFilter == "previous")
                {
                    <option value="previous" selected>الفصل السابق </option>
                }
                else
                {
                    <option value="previous">الفصل السابق </option>
                }
                @if (Model.IntakeFilter == "all")
                {
                    <option value="all" selected>كل الفصول</option>
                }
                else
                {
                    <option value="all">كل الفصول</option>
                }
            </select>
            <button class="admin-dashboard-btn admin-dashboard-btn-pink"
                    id="dashboardSearchSubmit"
                    type="submit">
                <i class="fas fa-search"></i> بحث
            </button>
            <a class="admin-dashboard-btn admin-dashboard-btn-outline"
               href="@Url.Action("Home", "AdminAr", new { intake = "all" })">
                <i class="fas fa-times"></i> مسح
            </a>
            <a class="admin-dashboard-btn admin-dashboard-btn-outline"
               href="@Url.Action("StudentList", "AdminAr", new { search = Model.SearchTerm, intake = Model.IntakeFilter })">
                <i class="fas fa-filter"></i> قائمة الطلاب
            </a>
        </form>

        <section class="admin-dashboard-stats">
            <article class="admin-dashboard-stat navy">
                <div class="admin-dashboard-stat-icon"><i class="fas fa-user-tie"></i></div>
                <div class="admin-dashboard-stat-label">الوكلاء المسجلون</div><div class="admin-dashboard-stat-value">@Model.TotalAgents</div>
                <div class="admin-dashboard-stat-foot"><i class="fas fa-check-circle"></i> سجلات الوكلاء النشطين</div>
            </article>
            <article class="admin-dashboard-stat">
                <div class="admin-dashboard-stat-icon"><i class="fas fa-user-graduate"></i></div>
                <div class="admin-dashboard-stat-label">إجمالي الطلاب</div><div class="admin-dashboard-stat-value">@Model.TotalStudents</div>
                <div class="admin-dashboard-stat-foot"><i class="fas fa-database"></i> السجلات النشطة الحالية</div>
            </article>
            <article class="admin-dashboard-stat gold">
                <div class="admin-dashboard-stat-icon"><i class="fas fa-hourglass-half"></i></div>
                <div class="admin-dashboard-stat-label">الموافقات المعلقة</div><div class="admin-dashboard-stat-value">@Model.PendingCount</div>
                <div class="admin-dashboard-stat-foot attention"><i class="fas fa-exclamation-triangle"></i> تتطلب مراجعة الإدارة</div>
            </article>
            <article class="admin-dashboard-stat pink">
                <div class="admin-dashboard-stat-icon"><i class="fas fa-user-check"></i></div>
                <div class="admin-dashboard-stat-label">تأكيد الطلاب</div><div class="admin-dashboard-stat-value">@Model.StudentConfirmedCount</div>
                <div class="admin-dashboard-stat-foot attention"><i class="fas fa-file-signature"></i> تم التأكيد من الطلاب</div>
            </article>
        </section>

        <section class="admin-dashboard-grid">
            <div class="admin-dashboard-stack">
                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-chart-bar"></i> ملخص حالات الطلبات</h2>

                    </div>
                    <div class="admin-dashboard-pipeline">
                        <div class="admin-dashboard-pipeline-numbers">
                            <div class="admin-dashboard-pipe-box"><strong>@Model.PendingCount</strong><span>معلّق</span></div>
                            <div class="admin-dashboard-pipe-box"><strong>@Model.UnderReviewCount</strong><span>قيد المراجعة</span></div>
                            <div class="admin-dashboard-pipe-box"><strong>@Model.RejectedCount</strong><span>مرفوض</span></div>
                            <div class="admin-dashboard-pipe-box"><strong>@Model.ApprovedCount</strong><span>مقبول</span></div>
                        </div>
                        <div class="admin-dashboard-bar" aria-label="توزيع حالات الطلبات"><span></span><span></span><span></span><span></span></div>
                    </div>
                </article>

                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-history"></i> أحدث طلبات الطلاب</h2>
                        <a class="admin-dashboard-view-link"
                           href="@Url.Action("StudentList", "AdminAr", new { intake = Model.IntakeFilter })">عرض كل الطلبات</a>
                    </div>
                    <div class="admin-dashboard-table-wrap">
                        <table id="dashboardApplicationsTable" class="admin-dashboard-table">
                            <thead><tr><th>الطالب</th><th>الكود</th><th>التخصص</th><th>الوكيل</th><th>التأكيد</th><th>الحالة</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var student in Model.LatestStudents)
                                {
                                    <tr>
                                        <td><div class="admin-dashboard-person"><span class="admin-dashboard-person-mark">@initials(student.studentNameArabic)</span>@student.studentNameArabic</div></td>
                                        <td>@student.studentCode</td>
                                        <td>@student.Major_Name</td>
                                        <td>@student.agentNameArabic</td>
                                        <td>@(student.approvedByStudent ? "نعم" : "لا")</td>
                                        <td><span class="admin-dashboard-status @statusClass(student.statusEnglish)">@statusText(student.statusEnglish)</span></td>
                                        <td><a class="admin-dashboard-more" href="@Url.Action("StudentInfo", "AdminAr", new { studentId = student.studentId })">مراجعة</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="admin-dashboard-empty-message" id="dashboardEmptyMessage">لم يتم العثور على طالب أو وكيل مطابق.</div>
                    </div>
                </article>

                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-star"></i> أداء الوكلاء</h2>
                        <a class="admin-dashboard-view-link"
                           href="@Url.Action("AgentStatistics", "AdminAr", new { intake = Model.IntakeFilter })">تقرير الأداء الكامل</a>
                    </div>
                    <div class="admin-dashboard-table-wrap">
                        <table id="dashboardAgentsTable" class="admin-dashboard-table">
                            <thead><tr><th>الوكيل</th><th>الطلاب</th><th>معلّق</th><th>مقبول</th><th>مرفوض</th><th>نسبة القبول</th><th>الحالة</th> <th>حالة الحساب</th></tr></thead>
                            <tbody>
                                @foreach (var agent in Model.AgentStatistics.Take(5))
                                {
                                    <tr>
                                        <td><div class="admin-dashboard-person"><span class="admin-dashboard-person-mark">@initials(agent.AgentName)</span>@agent.AgentName</div></td>
                                        <td>@agent.TotalStudents</td>
                                        <td>@agent.PendingCount</td>
                                        <td>@agent.ApprovedCount</td>
                                        <td>@agent.RejectedCount</td>
                                        <td><strong class="admin-dashboard-conversion">@agent.ApprovalRate.ToString("0.0")%</strong></td>
                                        <td><span class="admin-dashboard-health @agent.HealthCssClass">@healthText(agent.HealthStatus)</span></td>
                                        <td>
                                            <span class="agent-account-status @agent.AccountStatusCssClass">
                                                @agent.AccountStatusDisplay
                                            </span>

                                            @if (agent.IsContractExpired)
                                            {
                                                <small class="agent-contract-ended">
                                                    انتهى بتاريخ
                                                    @agent.ContractEndDate?.ToString("dd/MM/yyyy")
                                                </small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            </div>

            <aside class="admin-dashboard-stack">
                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-bell"></i> يتطلب الانتباه</h2>
                        <span class="admin-dashboard-view-link">@Model.Notifications.Count تنبيهات</span>
                    </div>
                    <div class="admin-dashboard-alerts">
                        <div class="admin-dashboard-alert-item"><div class="admin-dashboard-alert-icon"><i class="fas fa-exclamation-triangle"></i></div><div class="admin-dashboard-alert-copy"><strong>تنبيهات الوكلاء الحرجة</strong><span>يوصى بمراجعة الإدارة فورًا</span></div><div class="admin-dashboard-alert-count">@criticalAlerts</div></div>
                        <div class="admin-dashboard-alert-item"><div class="admin-dashboard-alert-icon gold"><i class="fas fa-clock"></i></div><div class="admin-dashboard-alert-copy"><strong>تنبيهات الوكلاء التحذيرية</strong><span>راجع ضغط العمل ونسب الرفض</span></div><div class="admin-dashboard-alert-count">@warningAlerts</div></div>
                        <div class="admin-dashboard-alert-item"><div class="admin-dashboard-alert-icon blue"><i class="fas fa-user-clock"></i></div><div class="admin-dashboard-alert-copy"><strong>وكلاء يحتاجون إلى متابعة</strong><span>حالة الأداء ليست جيدة حاليًا</span></div><div class="admin-dashboard-alert-count">@attentionAgents</div></div>
                        <div class="admin-dashboard-alert-item"><div class="admin-dashboard-alert-icon"><i class="fas fa-hourglass-half"></i></div><div class="admin-dashboard-alert-copy"><strong>طلبات الطلاب المعلقة</strong><span>طلبات بانتظار اتخاذ قرار</span></div><div class="admin-dashboard-alert-count">@Model.PendingCount</div></div>
                    </div>
                </article>

                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head"><h2 class="admin-dashboard-panel-title"><i class="fas fa-bolt"></i> إجراءات سريعة</h2></div>
                    <div class="admin-dashboard-quick-actions">
                        <a class="admin-dashboard-quick-action" href="@Url.Action("AddAgent", "AdminAr")"><i class="fas fa-user-plus"></i>إضافة وكيل جديد</a>
                        <a class="admin-dashboard-quick-action" href="#pendingRequests"><i class="fas fa-user-check"></i>مراجعة الموافقات</a>
                        <a class="admin-dashboard-quick-action" href="@Url.Action("Index", "AdmissionMajors")"><i class="fas fa-graduation-cap"></i>إدارة التخصصات</a>
@*                         <a class="admin-dashboard-quick-action" href="@Url.Action("AddStudent", "Ar")"><i class="fas fa-graduation-cap"></i>إضافة طالب جديد</a>

 *@    
@if (User.IsInRole("Super Admin"))
                        {
                            <a class="admin-dashboard-quick-action"
                               href="@Url.Action("AddStudent", "Ar")">
                                <i class="fas fa-user-plus"></i>
                                إضافة طالب جديد
                            </a>
                        }
</div>
                </article>

                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head"><h2 class="admin-dashboard-panel-title"><i class="fas fa-trophy"></i> أفضل الوكلاء</h2>
                        <a class="admin-dashboard-view-link"
                           href="@Url.Action("AgentStatistics", "AdminAr", new { intake = Model.IntakeFilter })">التفاصيل</a>
                    </div>
                    <div class="admin-dashboard-agent-list">
                        @foreach (var agent in topAgents)
                        {
                            <div class="admin-dashboard-agent-row"><div><a href="@Url.Action("StudentList", "AdminAr", new { agentId = agent.AgentId, intake = Model.IntakeFilter })"><strong>@agent.AgentName</strong><small>@agent.TotalStudents طالب · نسبة القبول @agent.ApprovalRate.ToString("0.0")%</small></a></div><div class="admin-dashboard-agent-score">@agent.ApprovedCount</div></div>
                        }
                    </div>
                </article>
            </aside>
        </section>

        <section class="admin-dashboard-panel admin-dashboard-pending-panel" id="pendingRequests">
            <div class="admin-dashboard-panel-head"><h2 class="admin-dashboard-panel-title"><i class="fas fa-hourglass-half"></i> الطلبات المعلقة</h2><span class="admin-dashboard-view-link">@Model.PendingTotalCount طلبات</span></div>
            <div class="admin-dashboard-table-wrap">
                <table class="admin-dashboard-table">
                    <thead><tr><th>الطالب</th><th>الكود</th><th>التخصص</th><th>الوكيل</th><th>الحالة</th> <th></th></tr></thead>
                    <tbody>
                        @foreach (var student in Model.PendingStudents)
                        {
                            <tr><td><div class="admin-dashboard-person"><span class="admin-dashboard-person-mark">@initials(student.studentNameArabic)</span>@student.studentNameArabic</div></td><td>@student.studentCode</td><td>@student.Major_Name</td><td>@student.agentNameArabic</td><td><span class="admin-dashboard-status pending">@statusText(student.statusEnglish)</span></td><td><a class="admin-dashboard-more" href="@Url.Action("StudentInfo", "AdminAr", new { studentId = student.studentId })">مراجعة</a></td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (pendingTotalPages > 1)
            {
                <nav class="admin-dashboard-pagination"
                     aria-label="صفحات الطلبات المعلقة">

                    <span class="admin-dashboard-pagination-summary">
                        عرض @pendingFirstRow-@pendingLastRow
                        من أصل @Model.PendingTotalCount
                    </span>

                    <div class="admin-dashboard-pagination-buttons">

                        @if (Model.CurrentPage > 1)
                        {
                            <a class="admin-dashboard-page-button"
                               href="@Url.Action(
                                                      "Home",
                                                      "AdminAr",
                                                      new
                                                      {
                                                          search = Model.SearchTerm,
                                                          intake = Model.IntakeFilter,
                                                          page = Model.CurrentPage - 1,
                                                          pageSize = Model.PageSize
                                                      })#pendingRequests">
                        السابق
                    </a>
                                        }

                        @for (var pageNumber = pendingFromPage;
                                            pageNumber <= pendingToPage;
                                            pageNumber++)
                        {
                            if (pageNumber == Model.CurrentPage)
                            {
                                <span class="admin-dashboard-page-button active"
                                      aria-current="page">
                                    @pageNumber
                                </span>
                            }
                            else
                            {
                                <a class="admin-dashboard-page-button"
                                   href="@Url.Action(
                                                              "Home",
                                                              "AdminAr",
                                                              new
                                                              {
                                                                  search = Model.SearchTerm,
                                                                  intake = Model.IntakeFilter,
                                                                  page = pageNumber,
                                                                  pageSize = Model.PageSize
                                                              })#pendingRequests">
                        @pageNumber
                    </a>
                                        }
                        }

                        @if (Model.CurrentPage < pendingTotalPages)
                        {
                            <a class="admin-dashboard-page-button"
                               href="@Url.Action(
                                                      "Home",
                                                      "AdminAr",
                                                      new
                                                      {
                                                          search = Model.SearchTerm,
                                                          intake = Model.IntakeFilter,
                                                          page = Model.CurrentPage + 1,
                                                          pageSize = Model.PageSize
                                                      })#pendingRequests">
                        التالي
                    </a>
                                        }

                    </div>
                </nav>
            }
        </section>
    </main>
</div>

<script>
    (function () {
        "use strict";

        function initializeDashboardFilters() {
            var form = document.getElementById("dashboardFilterForm");
            var searchInput = document.getElementById("dashboardSearchInput");
            var intakeSelect = document.getElementById("dashboardIntakeSelect");

            if (!form || !searchInput || !intakeSelect) return;

            function navigateToFilteredDashboard(event) {
                if (event) event.preventDefault();

                var baseUrl = form.getAttribute("data-dashboard-filter-url") || form.action;
                var parameters = new URLSearchParams();
                var search = (searchInput.value || "").trim();
                var intake = intakeSelect.value || "current";

                if (search.length > 0) parameters.set("search", search);
                parameters.set("intake", intake);
                parameters.set("page", "1");

                window.location.assign(baseUrl + "?" + parameters.toString());
            }

            form.addEventListener("submit", navigateToFilteredDashboard);
            intakeSelect.addEventListener("change", navigateToFilteredDashboard);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initializeDashboardFilters);
        } else {
            initializeDashboardFilters();
        }
    })();
</script>
