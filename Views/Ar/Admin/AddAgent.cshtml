@using University_Agent_System.Models
@using University_Agent_System.Models.ViewModel
@model AgentViewModel
@{
    Layout = "_LayoutAdminAr";
}

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ViewBag.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}
<main>
    <div class="container-fluid padding margin" style="background:#d0d0cf">

        <div class="row">
            <!---------------إضافة وكيل جديد---------------->
            <div class="col-lg-12">
                <section id="title-wrapper" style=" justify-content: End;">

                    <h1 class="sectiontitle heading7"><p style="text-align: center;"><span style="color: #252468;">إضافة وكيل جديد</span></p></h1>
                    <div class="lineright" style="display: block; background-color: #DAA328; "></div>
                </section>

                <div class="partspacing"></div>
                <div class="row">
                    <dikv class="col-lg-12">
                        <h2 class="heading14">معلومات الوكيل</h2>
                    </dikv>
                </div>
            </div>
                       <form action="AddAgent" method="post" enctype="multipart/form-data">

@Html.AntiForgeryToken()
                <div class="partspacing"></div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="AgentNameEnglish" class="form-label heading16 labelspacing">اسم الوكيل بالانجليزي:<span style="color:red">*</span></label>
                            </div>
                            <!------------------- AgentName/textBox-------------->
                            <div class="col-lg-8" style="padding-right:8px">
                                <input asp-for="agentNameEnglish" type="text" class="form-control " id="AgentName" placeholder="" name="agentNameEnglish" dir="ltr">

                                <span asp-validation-for="agentNameEnglish" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- اسم الوكيل/التسمية -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="AgentName" class="form-label heading16 labelspacing"> اسم الوكيل بالعربي: <span style="color:red">*</span></label>
                            </div>
                            <!------------------- مربع النص اسم الوكيل -------------->
                            <div class="col-lg-8" style="padding-right: 8px">
                                <input asp-for="agentNameArabic" type="text" class="form-control " id="AgentName" placeholder="" name="agentNameArabic">

                                <span asp-validation-for="agentNameArabic" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                  </div>
                <script>
                                      function validateAgentCode(input) {

                           
                      const errorSpan = document.getElementById("agentCodeError");

                      if (/[^0-9]/.test(input.value)) {
                        errorSpan.textContent = "Numbers only";
                      } else {
                        errorSpan.textContent = "";
                      }
                    }
                </script>

                <div class="rowspacing"></div>
                <div class="row">
                    <!-- كود الوكيل -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="AgentCode" class="form-label heading16 labelspacing">كود الوكيل: <span style="color:red">*</span></label>
                            </div>
                            <!------------------- مربع النص كود الوكيل -------------->
                            <div class="col-lg-8" style="padding-right: 8px">
                                <input asp-for="agentCode" type="text" class="form-control " id="AgentCode" placeholder="" name="agentCode" oninput="validateAgentCode(this)">
                                <span id="agentCodeError" style="color: red;"></span>
                                <span asp-validation-for="agentCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="partspacing"></div>
                <!-- التسمية -->
                <div class="row">
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="idNumber" class="form-label heading16 labelspacing" id="idNumber_L">الرقم الوطني: <span style="color:red">*</span></label>
                            </div>
                            <!-- مربع نص رقم الهوية -->
                            <div class="col-lg-8" style="padding-right:8px">
                                <input asp-for="nationalId" type="text" class="form-control" id="idNumber" placeholder="" name="nationalId">
                                <span asp-validation-for="nationalId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <!-- الجنسية/التسمية -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="Nationality" class="form-label heading16 labelspacing" id="Nationality_L">الجنسية:<span style="color:red">*</span></label>
                            </div>
                            <!-- الجنسية/قائمة منسدلة -->
                            <div class="col-lg-8" style="padding-right: 8px">
                                <div class="input-group">
                                    <input class="form-control" type="search" value="" id="recivedGroup" onkeyup="filterNationality()" placeholder="ابحث عن الجنسية...">
                                    <input asp-for="nationalityId" type="hidden" id="selectedNationalityId" name="nationalityId"> <!-- Hidden input to store nationalityId -->
                                    <span class="input-group-append">
                                        <button class="btn btn-outline-secondary bg-white border-bottom-0 border  ms-n5" type="button">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </span>
                                </div>
                                <!-- Options will be dynamically filtered in this list (Initially hidden) -->
                                <ul id="nationalityOptions" class="list-group mt-2" style="display: none;">
                                    @foreach (var nationality in Model.Nationalities)
                                    {
                                        <li class="list-group-item nationality-item" data-id="@nationality.nationalityId">
                                            @nationality.nationalityArabic
                                        </li>
                                    }
                                </ul>
                                <span asp-validation-for="nationalityId" class="text-danger"></span>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="rowspacing"></div>

                <div class="row">
                    <!-- البلد/التسمية -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="Country" class="form-label heading16 labelspacing" id="Country_L">البلد:<span style="color:red">*</span></label>
                            </div>
                            <!-- البلد/قائمة منسدلة -->
                            <div class="col-lg-8" style="padding-right: 8px">
                                <div class="input-group">
                                    <input class="form-control" type="search" value="" id="countrySearch" onkeyup="filterCountry()" placeholder="ابحث عن الدولة...">
                                    <input asp-for="countryId" type="hidden" id="selectedCountryId" name="countryId"> <!-- Hidden input to store countryId -->
                                    <span class="input-group-append">
                                        <button class="btn btn-outline-secondary bg-white border-bottom-0 border  ms-n5" type="button">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </span>
                                </div>
                                <ul id="countryOptions" class="list-group mt-2" style="display: none;">

                                    @foreach (var country in Model.Countries)
                                    {
                                        <li class="list-group-item country-item" data-id="@country.countryId">
                                            @country.countryArabic
                                        </li>
                                    }
                                </ul>
                                <span asp-validation-for="countryId" class="text-danger"></span>

                            </div>
                        </div>
                    </div>
                    <!-- المدينة / المحافظة -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="goverText" class="form-label heading16 labelspacing" id="idNumber_L">المدينة / المحافظة:<span style="color:red">*</span></label>
                            </div>
                            <!-- مربع نص المدينة -->
                            <div class="col-lg-8" style="padding-right: 8px">
                                <input asp-for="city" name="city" type="text" class="form-control" id="goverText" placeholder="">
                                <span asp-validation-for="city" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="rowspacing"></div>

                <div class="row">
                    <!-- رقم الهاتف -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="phone" class="form-label heading16 labelspacing" id="phone_L">رقم الهاتف:<span style="color:red">*</span></label>
                            </div>
                            <!-- مربع نص رقم الهاتف -->
                            @* <div class="col-lg-8" style="padding-right: 8px">
                                <input asp-for="agentPhone" type="text" class="form-control" id="phone" placeholder="" name="agentPhone">
                                <span asp-validation-for="agentPhone" class="text-danger"></span>
                            </div> *@

                            <div class="col-lg-8" style="padding-left:8px">
                                <div class="row">
                                    <div class="col-md-5">
                                        <select asp-for="agentPhoneCountryIso2"
                                                asp-items="Model.PhoneCountries"
                                                class="form-select"
                                                id="agentPhoneCountryIso2">
                                            <option value="">اختر البلد</option>
                                        </select>
                                        <span asp-validation-for="agentPhoneCountryIso2" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-7">
                                        <input asp-for="agentPhoneNational"
                                               type="text"
                                               class="form-control"
                                               id="agentPhoneNational"
                                               placeholder="ادخل رقم الهاتف المحلي" />
                                        <span asp-validation-for="agentPhoneNational" class="text-danger"></span>
                                    </div>
                                </div>

                                <input asp-for="agentPhone" type="hidden" id="agentPhone" />
                                <span asp-validation-for="agentPhone" class="text-danger"></span>

                                <small class="text-muted d-block mt-1">
                                    سيكون الرقم النهائي المحفوظ بالصيغة الدولية.
                                </small>

                                <div id="phonePreview" class="mt-2 text-primary fw-bold"></div>
                            </div>

                        </div>
                    </div>
                    <!-- البريد الإلكتروني -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="Email" class="form-label heading16 labelspacing" id="Email_L">البريد الإلكتروني:<span style="color:red">*</span></label>
                            </div>
                            <!-- مربع نص البريد الإلكتروني -->
                            <div class="col-lg-8" style="padding-right: 8px">
                                <input asp-for="agentEmail" type="text" class="form-control" id="Email" placeholder="" name="agentEmail">
                                <span asp-validation-for="agentEmail" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="partspacing"></div>
                <div class="row">

                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="commission" class="form-label heading16 labelspacing" id="commission">عمولة الوكيل في العقد</label>
                            </div>
                            <!-- commission TextBox -->
                            <div class="col-lg-8" style="padding-right:8px">
                                <input asp-for="commission" type="text" class="form-control" id="commission" placeholder="" name="commission">
                            </div>
                        </div>
                    </div>

                    <!-- ContractDate/label -->
                    <div class="col-lg-6">
                        <div class="row g-0">
                            <div class="col-lg-4">
                                <label for="ContractDate" class="form-label heading16 labelspacing">تاريخ العقد</label>
                            </div>
                            <div class="col-lg-8">
                                <div class="row">
                                    <!-- From/label & DateBox -->
                                    <div class="col-lg-6">
                                        <div class="row">
                                            <div class="col-lg-2">
                                                <label for="from" class="form-label normal labelspacing2"><span style="color:red">*</span>من</label>
                                            </div>
                                            <div class="col-lg-10">
                                                <input asp-for="contractStartDate" type="date" class="form-control" id="from" name="contractStartDate">
                                                <span asp-validation-for="contractStartDate" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- To/label & DateBox -->
                                    <div class="col-lg-6">
                                        <div class="row">
                                            <div class="col-lg-2">
                                                <label for="to" class="form-label normal labelspacing2"><span style="color:red">*</span>إلى</label>
                                            </div>
                                            <div class="col-lg-10">
                                                <input asp-for="contractEndDate" type="date" class="form-control" id="to" name="contractEndDate">
                                                <span asp-validation-for="contractEndDate" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rowspacing"></div>

                </div>

                <div class="row">

                    <div class="col-lg-6">
                        <div class=" row g-0">
                            <div class="col-lg-4">
                                <label for="agentContract" class="form-label heading16 labelspacing">عقد الوكيل:<span style="color:red">*</span></label>
                            </div>
                            <div class="col-lg-8" style="padding-right:8px">
                                <input asp-for="agentContract" type="file" class="form-control" id="agentContract" name="agentContract" accept=".pdf, .jpg, .png">
                                <span asp-validation-for="agentContract" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6"></div>
                </div>

                <div class="rowspacing"></div>
                <div class="row">
                    <!-- رقم الآيبان/التسمية -->
                    <div class="col-lg-2">
                        <label for="Iban" class="form-label heading16 labelspacing">رقم الحساب المصرفي الدولي:</label>
                    </div>
                    <!-- مربع نص رقم الآيبان -->
                    <div class="col-lg-10">
                        <input asp-for="agentIban" type="text" class="form-control" id="Iban" placeholder="" name="agentIban">
                    </div>
                </div>
                <div class="partspacing"></div>

                <div class="row">
                    <!-- كلمة المرور -->
                    <div class="col-lg-2">
                        <label for="Passowrd" class="form-label heading16 labelspacing">كلمة المرور:</label>
                    </div>
                    <!-- مربع نص كلمة المرور -->
                    <div class="col-lg-10">
                        <input type="text" class="form-control " id="Passowrd" placeholder="" name="passowrd" value="@Model.passowrd" readonly style="background-color: #f5f5f5;">
                    </div>
                </div>
                <div class="rowspacing"></div>

                <div class="row">
                    <!-- ملاحظات/معلومات إضافية -->
                    <div class="col-lg-2">
                        <label for="notes" class="form-label heading16 labelspacing">ملاحظات / معلومات إضافية:</label>
                    </div>
                    <!-- مربع نص الملاحظات -->
                    <div class="col-lg-10">
                        <textarea asp-for="notes" class="form-control " id="notes" placeholder="" name="notes"></textarea>
                    </div>
                </div>
         
            <div class="partspacing"></div>

            <div class="row">
                <div class="col-lg-2"></div>
                <div class="col-lg-8">
                    <!-- زر الحفظ -->
                    <div class="btnwrap" style="">
                            <button type="submit" class="mybtn heading15" style="background-color: #C81589; padding-left: 25% !important; padding-right: 25% !important;border:none;">
                            حفظ
                            <span class="line" style="border: 0px;"></span>
                            <span class="areaborder" style="border-top-color: #C81589 !important; border-left-color: #C81589 !important; border-right-color: #C81589 !important; border-bottom-color: #C81589 !important;"></span>
                        </button>
                    </div>
                </div>
                <div class="col-lg-2"></div>
            </div>
           </form>
            <div class="partspacing"></div>
        </div>
    </div>

</main>

<script>

          function filterCountry() {
           var input, filter, list, items, i, txtValue;
           input = document.getElementById('countrySearch');
           filter = input.value.toUpperCase();
           list = document.getElementById('countryOptions');
           items = list.getElementsByTagName('li');

           // If input is not empty, display the options
           if (input.value.length > 0) {
               list.style.display = "block"; // Show options
           } else {
               list.style.display = "none"; // Hide options when input is empty
           }

           // Loop through all options and hide those that don't match the search
           for (i = 0; i < items.length; i++) {
               txtValue = items[i].textContent || items[i].innerText;
               if (txtValue.toUpperCase().indexOf(filter) > -1) {
                   items[i].style.display = "";
               } else {
                   items[i].style.display = "none";
               }
           }
       }


    // Function to populate the input with the selected option
       document.querySelectorAll('.country-item').forEach(function(item) {
           item.addEventListener('click', function() {
               var countryName = item.innerText;
               var countryId = item.getAttribute('data-id');

               // Populate the input field with the selected country
               document.getElementById('countrySearch').value = countryName;

               // Store the countryId in a hidden input for later use
               document.getElementById('selectedCountryId').value = countryId;

               // Hide the options list
               document.getElementById('countryOptions').style.display = "none";
           });
       });



           function filterNationality() {
                               var input, filter, list, items, i, txtValue;
                               input = document.getElementById('recivedGroup');
                               filter = input.value.toUpperCase();
                               list = document.getElementById('nationalityOptions');
                               items = list.getElementsByTagName('li');

                               // If input is not empty, display the options
                               if (input.value.length > 0) {
                                   list.style.display = "block"; // Show options
                               } else {
                                   list.style.display = "none"; // Hide options when input is empty
                               }

                               // Loop through all options and hide those that don't match the search
                               for (i = 0; i < items.length; i++) {
                                   txtValue = items[i].textContent || items[i].innerText;
                                   if (txtValue.toUpperCase().indexOf(filter) > -1) {
                                       items[i].style.display = "";
                                   } else {
                                       items[i].style.display = "none";
                                   }
                               }
                           }


                       // Function to populate the input with the selected option
                        document.querySelectorAll('.nationality-item').forEach(function(item) {
                            item.addEventListener('click', function() {
                                var nationalityName = item.innerText;
                                var nationalityId = item.getAttribute('data-id');

                                // Populate the input field with the selected nationality
                                document.getElementById('recivedGroup').value = nationalityName;

                                // Store the nationalityId in a hidden input for later use
                                document.getElementById('selectedNationalityId').value = nationalityId;


                                // Hide the options list
                                document.getElementById('nationalityOptions').style.display = "none";
                            });
                        });
    document.getElementById("dropdowndegree").addEventListener("change", function () {
        const selectedDegreeId = parseInt(this.value);
        document.getElementById("selectedDegreeId").value = selectedDegreeId; // update hidden input
    });


</script>


<script>
    function updatePhonePreview() {
        const countrySelect = document.getElementById("agentPhoneCountryIso2");
        const nationalInput = document.getElementById("agentPhoneNational");
        const hiddenPhone = document.getElementById("agentPhone");
        const preview = document.getElementById("phonePreview");

        if (!countrySelect || !nationalInput || !hiddenPhone || !preview) return;

        let countryText = countrySelect.options[countrySelect.selectedIndex]?.text || "";
        let national = nationalInput.value || "";

        national = national.replace(/[^\d]/g, "");

        const match = countryText.match(/\(\+(\d+)\)/);
        const dialingCode = match ? "+" + match[1] : "";

        const full = dialingCode && national ? dialingCode + national : "";

        hiddenPhone.value = full;
        preview.innerText = full ? "Preview: " + full : "";
    }

    document.addEventListener("DOMContentLoaded", function () {
        const countrySelect = document.getElementById("agentPhoneCountryIso2");
        const nationalInput = document.getElementById("agentPhoneNational");

        if (countrySelect) countrySelect.addEventListener("change", updatePhonePreview);
        if (nationalInput) nationalInput.addEventListener("input", updatePhonePreview);

        updatePhonePreview();
    });
</script>
