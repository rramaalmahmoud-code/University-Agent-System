 <div class="header-profile-container">

        <button type="button"
                class="profilelink header-profile-button"
                id="profileToggle"
                aria-haspopup="true"
                aria-expanded="false">

            <span class="header-profile-avatar">
                @profileInitial
            </span>

            <span class="header-profile-information">
                <strong>@loggedInUserName</strong>
                <small>@roleDisplayName</small>
            </span>

            <i class="fas fa-chevron-down header-profile-arrow"></i>
        </button>

        <div id="dropdownMenu"
             class="header-profile-dropdown">

            <div class="header-profile-dropdown-user">

                <span class="header-profile-dropdown-avatar">
                    @profileInitial
                </span>

                <div class="header-profile-dropdown-details">
                    <strong>@loggedInUserName</strong>
                    <small>@roleDisplayName</small>
                </div>

            </div>

            <div class="header-profile-dropdown-divider"></div>

            <a href="@Url.Action("Logout", logoutController)"
               class="header-profile-logout">

                <i class="fas fa-sign-out-alt"></i>

                <span>
                    @(isArabic ? "تسجيل الخروج" : "Logout")
                </span>
            </a>

        </div>
    </div>
 <script>
        const toggle = document.getElementById('profileToggle');
        const menu = document.getElementById('dropdownMenu');

        toggle.addEventListener('click', function (e) {
            e.preventDefault();
            menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
        });

        document.addEventListener('click', function (e) {
            if (!toggle.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
            }
        });
    </script>

