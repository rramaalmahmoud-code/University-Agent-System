 @inject University_Agent_System.Services.AgentHelper agentHelper
@using System
@using System.Security.Claims
@{
    
    var agentStatus = agentHelper.GetAgentStatus();

}
@{
    string currentAction = ViewContext.RouteData.Values["action"].ToString();
    string currentController = ViewContext.RouteData.Values["controller"].ToString();
    string newLang = currentController.Contains("Ar") ? "en" : "ar";
    string newController = currentController.Contains("Ar")
        ? currentController.Replace("Ar", "En")
        : currentController.Replace("En", "Ar");

    bool isArabic =
     currentController.IndexOf(
         "Ar",
         StringComparison.OrdinalIgnoreCase) >= 0;

    string userType =
        User.FindFirst("userType")?.Value ??
        User.FindFirst(ClaimTypes.Role)?.Value ??
        "User";

    string loggedInUserName = isArabic
        ? User.FindFirst("displayNameArabic")?.Value
        : User.FindFirst("displayNameEnglish")?.Value;

    if (string.IsNullOrWhiteSpace(loggedInUserName))
    {
        loggedInUserName =
            User.FindFirst(ClaimTypes.Name)?.Value ??
            User.Identity?.Name ??
            (isArabic ? "مستخدم" : "User");
    }

    string roleDisplayName;

    if (isArabic)
    {
        roleDisplayName = userType switch
        {
            "Super Admin" => "مدير النظام",
            "Admin" => "مسؤول",
            "Agent" => "وكيل",
            _ => "مستخدم"
        };
    }
    else
    {
        roleDisplayName = userType switch
        {
            "Super Admin" => "Super Admin",
            "Admin" => "Admin",
            "Agent" => "Agent",
            _ => "User"
        };
    }

    string profileInitial =
        string.IsNullOrWhiteSpace(loggedInUserName)
            ? "U"
            : loggedInUserName
                .Trim()
                .Substring(0, 1)
                .ToUpperInvariant();

    string logoutController =
        isArabic ? "Ar" : "En";

    object routeValues;
    var studentIdQuery = Context.Request.Query["studentId"].FirstOrDefault();

    // 👇 اختاري إذا في ID أو لا
    if (ViewContext.RouteData.Values.ContainsKey("id"))
    {
        routeValues = new { culture = newLang, id = ViewContext.RouteData.Values["id"] };
    }
    else if (!string.IsNullOrEmpty(studentIdQuery))
    {
        routeValues = new { culture = newLang, studentId = studentIdQuery };
    }
    else
    {
        routeValues = new { culture = newLang };
    }
}

