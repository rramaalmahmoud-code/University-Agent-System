    <div id="dropdownMenu" style="display: none; position: absolute; top: 100%; right: 5%; background: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); border-radius: 5px; min-width: 120px; z-index: 9999; text-align: left;">
        <a href="@Url.Action("Logout", "En")" style="padding: 10px 15px; display: block; text-decoration: none; color: #333;">Logout</a>
        </div>
   

    <script>
        const toggle = document.getElementById('profileToggle');
        const menu = document.getElementById('dropdownMenu');

        toggle.addEventListener('click', function (e) {
            e.preventDefault();
            menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
        });

        document.addEventListener('click', function (e) {
            if (!toggle.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = 'none';
            }
        });
    </script>

