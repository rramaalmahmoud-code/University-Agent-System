 @inject University_Agent_System.Services.AgentHelper agentHelper
@{
 
    var agentStatus = agentHelper.GetAgentStatus();

}
@{
    string currentAction = ViewContext.RouteData.Values["action"].ToString();
    string currentController = ViewContext.RouteData.Values["controller"].ToString();
    string newLang = currentController.Contains("Ar") ? "en" : "ar";
    string newController = currentController.Contains("Ar")
        ? currentController.Replace("Ar", "En")
        : currentController.Replace("En", "Ar");

 

    object routeValues;
    var studentIdQuery = Context.Request.Query["studentId"].FirstOrDefault();

    // 👇 اختاري إذا في ID أو لا
    if (ViewContext.RouteData.Values.ContainsKey("id"))
    {
        routeValues = new { culture = newLang, id = ViewContext.RouteData.Values["id"] };
    }
    else if (!string.IsNullOrEmpty(studentIdQuery))
    {
        routeValues = new { culture = newLang, studentId = studentIdQuery };
    }
    else
    {
        routeValues = new { culture = newLang };
    }
}


