@model University_Agent_System.Models.ViewModel.StudentListViewModel
@{
    Layout = "_Layout";
    var selectedTab = Context.Request.Query["tab"].ToString()?.ToLower() ?? "tab1";
    if (string.IsNullOrEmpty(selectedTab)) selectedTab = "tab1";
}


<tbody>
<main>
    <div class="container-fluid padding margin" style="background:#d0d0cf">

        <div class="row">

            <div class="col-lg-12">
                <section id="title-wrapper" style=" justify-content: End;">

                    <h1 class="sectiontitle heading7"><p style="text-align: center;"><span style="color: #252468;">HOME</span></p></h1>
                    <div class="lineright" style="display: block; background-color: #DAA328; "></div>
                </section>

                <div class="partspacing"></div>
                <div class="row">
                    <div class="col-lg-2"></div>
                    <div class="col-lg-8">
                            <form method="get">
                                <select name="SelectedAcademicYear" asp-for="SelectedAcademicYear" onchange="this.form.submit()" class="form-select heading15" id="dropdown1" style="width: 100%; padding-right: 30px; border-color: #C81589;">
                                    <option value="0" selected>Academic Year</option>
                                    @foreach (var year in Model.AcadimicYears)
                                    {
                                        <option value="@year.Value">@year.Text</option>
                                    }
                                </select>
                            </form>

                    </div>
                    <div class="col-lg-2"></div>
                </div>


                <div class="partspacing"></div>


                <div class="        " style="background-size: 100% !important;-webkit-background-size: cover !important;-moz-background-size: cover !important;-o-background-size: cover !important;background-size: cover !important;background-position: center !important;">
                    <h2 class="heading14" style="
    margin-left: 5px;
">
                            Academic Year @Model.SelectedAcademicYear
                    </h2>
                    <div id="tabs" style="margin-top: 10px;">
                        <!-- Nav tabs -->
                            <ul class="nav nav-pills nav-justified">
                                <li class="nav-item">
                                    <a class="nav-link @(selectedTab == "tab1" ? "active" : "")" href="?SelectedAcademicYear=@Model.SelectedAcademicYear&tab=tab1"><p>First Semester</p></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(selectedTab == "tab2" ? "active" : "")" href="?SelectedAcademicYear=@Model.SelectedAcademicYear&tab=tab2"><p>Second Semester</p></a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(selectedTab == "tab3" ? "active" : "")" href="?SelectedAcademicYear=@Model.SelectedAcademicYear&tab=tab3"><p>Summer Semester</p></a>
                                </li>
                            </ul>


                        <div class="tab-content">


                                <div class="tab-pane container-fluid @(selectedTab == "tab1" ? "active show" : "")" id="tab1">


                                <div class="partspacing"></div>

                                <div class="row">
                                    <div class="col-lg-2"></div>
                                    <div class="col-lg-8">




                                        <div class="countersection ">
                                            <h2 class="countertitle">
                                                <p>
                                                    <span class="heading8">
                                                        Total number of students for
                                                            the first semester @Model.SelectedAcademicYear:
                                                    </span>
                                                </p>
                                            </h2>
                                            <span class="countercorner" style="  "></span>
                                            <div class="counterposition">
                                                <div class="counterarea heading5" style="background-color: #264C9F; ">
                                                        <span style="color:inherit;" data-toggle="counterUp">@Model.FirstSemesterStudents?.Count()</span><span></span>
                                                    <span class="counterareacorner" style="  "></span>
                                                </div>
                                            </div>
                                        </div>




                                    </div>
                                    <div class="col-lg-2"></div>
                                </div>






                            </div>



                                <div class="tab-pane container-fluid @(selectedTab == "tab2" ? "active show" : "")" id="tab2">



                                <div class="partspacing"></div>

                                <div class="row">
                                    <div class="col-lg-2"></div>
                                    <div class="col-lg-8">




                                        <div class="countersection ">
                                            <h2 class="countertitle">
                                                <p>
                                                    <span class="heading8">
                                                        Total number of students for
                                                            the second semester @Model.SelectedAcademicYear:
                                                    </span>
                                                </p>
                                            </h2>
                                            <span class="countercorner" style="  "></span>
                                            <div class="counterposition">
                                                <div class="counterarea heading5" style="background-color: #264C9F; ">
                                                        <span style="color:inherit;" data-toggle="counterUp">@Model.SecondSemesterStudents?.Count()</span><span></span>
                                                    <span class="counterareacorner" style="  "></span>
                                                </div>
                                            </div>
                                        </div>




                                    </div>
                                    <div class="col-lg-2"></div>
                                </div>





                            </div>




                                <div class="tab-pane container-fluid @(selectedTab == "tab3" ? "active show" : "")" id="tab3">



                                <div class="partspacing"></div>

                                <div class="row">
                                    <div class="col-lg-2"></div>
                                    <div class="col-lg-8">




                                        <div class="countersection ">
                                            <h2 class="countertitle">
                                                <p>
                                                    <span class="heading8">
                                                        Total number of students for
                                                            the summmer semester @Model.SelectedAcademicYear:
                                                    </span>
                                                </p>
                                            </h2>
                                            <span class="countercorner" style="  "></span>
                                            <div class="counterposition">
                                                <div class="counterarea heading5" style="background-color: #264C9F; ">
                                                        <span style="color:inherit;" data-toggle="counterUp">@Model.SummerSemesterStudents?.Count()</span><span></span>
                                                    <span class="counterareacorner" style="  "></span>
                                                </div>
                                            </div>
                                        </div>




                                    </div>
                                    <div class="col-lg-2"></div>
                                </div>





                            </div>


                        </div>


                    </div>

                </div>



            </div>

        </div>

    </div>

    <div class="container-fluid padding margin">
        <div class="row">
            <div class="col-lg-2"></div>
            <div class="col-lg-8">
                <table>

                    <thead class="table-light">
                        <tr style="background: #ecebea">

                            <th>Student Name</th>
                            <th>Major</th>
                            <th>Phone Number</th>

                        </tr>
                    </thead>
                        <tbody>
                            @{
                                var students = selectedTab switch
                                {
                                    "tab1" => Model.FirstSemesterStudents,
                                    "tab2" => Model.SecondSemesterStudents,
                                    "tab3" => Model.SummerSemesterStudents,
                                    _ => Model.FirstSemesterStudents
                                };

                                if (students != null && students.Any())
                                {
                                    foreach (var student in students)
                                    {
                                        <tr>
                                            <td data-label="Student Name" class="readsub">@student.studentNameEnglish</td>
                                            <td data-label="Major" class="readsub">@student.Major_Name_S</td>
                                            <td data-label="Phone Number" class="readsub">@student.studentPhone</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3">No students found for this semester.</td>
                                    </tr>
                                }
                            }
                        </tbody>

              </table>

            </div>
            <div class="col-lg-2"></div>
        </div>
    </div>
</main>
