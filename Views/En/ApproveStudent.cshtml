@{
}

@{
    ViewData["Title"] = "الموافقة على التسجيل";
}

@if (Model.studentApproval == 1)
{
    <div class="alert alert-success">
        ✅ لقد قمتَ بالموافقة على تسجيلك مسبقًا. شكرًا لك!
    </div>
}
else
{
    <h2>مرحبًا بك @Model.studentNameArabic</h2>
    <p>قام وكيلك بتسجيلك في جامعة AAU.</p>
    <p>انقر على "تأكيد" للموافقة على تسجيلك.</p>

    <form method="post" asp-action="ApproveStudent" asp-route-id="@Model.studentId">
        <button type="submit" class="btn btn-success">✅ تأكيد الموافقة</button>
    </form>
}