@model University_Agent_System.Models.ViewModel.PreliminaryAcceptanceDocVM
@{
    Layout = null;

    // Gender word: adjust values if your DB uses different mapping
    string studentWord = "الطالب/ة";
    string pronoun = "ـه/ـا";

    if (Model.StudentGender == 1) // Male
    {
        studentWord = "الطالب";
        pronoun = "ـه";
    }
    else if ( Model.StudentGender == 0) // Female (support both)
    {
        studentWord = "الطالبة";
        pronoun = "ـها";
    }
    else
    {
        studentWord = "الطالب/ة";
        pronoun = "ه/ها";
    }
    // Semester text from semesterId (e.g. 20241 -> year=2024, sem=1)
    string semText = "";
    string acadYear = "";
    if (Model.SemesterId > 0)
    {
        int year = Model.SemesterId / 10;
        int sem = Model.SemesterId % 10;

        acadYear = year.ToString() + "/" + (year + 1).ToString();

        if (sem == 1) semText = "الفصل الأول";
        else if (sem == 2) semText = "الفصل الثاني";
        else if (sem == 3) semText = "الفصل الصيفي";
        else semText = "الفصل الدراسي";
    }

    string dateText = Model.LetterDate.ToString("dd / MM / yyyy");
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>وثيقة قبول مبدئي</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        /* Print A4 */
        @@page {
            size: A4;
            margin: 0;
        }

        html, body {
            margin: 0;
            padding: 0;
            background: #f3f3f3;
        }

        /* Page */
        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            background: #fff;
            box-sizing: border-box;
            padding: 18mm 18mm 20mm;
            font-family: "Times New Roman", NEOSANSARABIC, Arial;
            color: #000;
        }

        /* =========================
               Header with AAU logo
               ========================= */
        .doc-header {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: start;
            column-gap: 10mm;
            margin-bottom: 16px;
        }

        .header-ar {
            text-align: right;
            direction: rtl;
            font-size: 18px;
            font-weight: 700;
            line-height: 1.6;
            white-space: nowrap;
        }

        .header-en {
            text-align: left;
            direction: ltr;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.5;
            white-space: nowrap;
        }

        .logo-box {
            text-align: center;
        }

        .aau-logo {
            display: block;
            width: 32mm;
            max-width: 32mm;
            height: auto;
            margin: 0 auto;
        }

        .header-date {
            margin-top: 5px;
            font-size: 15px;
            font-weight: 700;
            text-align: right;
            direction: rtl;
            white-space: nowrap;
        }

            .header-date .date-value {
                direction: ltr;
                unicode-bidi: embed;
                font-weight: 400;
            }

        .title {
            text-align: center;
            font-size: 26px;
            font-weight: 700;
            margin: 20px 0 12px;
        }

        .salutation {
            font-size: 18px;
            font-weight: 700;
            margin: 12px 0 8px;
            text-align: right;
        }

        .para {
            font-size: 18px;
            line-height: 2;
            text-align: justify;
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            margin-top: 16px;
        }

        ul.docs {
            margin: 8px 0 0;
            padding-right: 22px;
            font-size: 18px;
            line-height: 2;
        }

        .payment-box {
            background: #e9e9e9;
            padding: 12px 14px;
            margin-top: 18px;
        }

            .payment-box .para {
                margin-top: 8px;
            }

        .payment-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            align-items: center;
            font-size: 16px;
            margin-top: 0;
        }

            .payment-row .pay-right {
                text-align: right;
            }

            .payment-row .pay-center {
                text-align: center;
            }

            .payment-row .pay-left {
                text-align: left;
            }

            .payment-row .col {
                width: 49%;
            }

        .ltr {
            direction: ltr;
            unicode-bidi: embed;
        }

        .signature {
            margin-top: 26px;
            text-align: left !important;
            font-size: 18px;
            line-height: 1.6;
        }

        .sig-title,
        .sig-name {
            text-align: left !important;
        }

        .signature-img {
            display: block;
            width: 55mm;
            height: auto;
            margin: 6px 0;
            margin-right: auto;
            margin-left: 0;
        }

        .note {
            margin-top: 18px;
            font-size: 16px;
            background: #e9e9e9;
            padding: 8px 10px;
        }

        .b {
            font-weight: 700;
        }

        /* Print tweaks */
        @@media print {
            html, body {
                background: #fff;
            }

            .page {
                margin: 0;
            }
        }
    </style>
</head>
<body>
    <div class="page">

        <!-- Top line: date + department (as in your template) -->
       <!-- <div class="hdr1">دائرة القبول والتسجيل</div>

        // <div class="hdr2">
        //     <div class="date"><b>التاريخ :</b> @dateText</div>
        //     <div class="dept">Department of Admission and Registration</div>
         // </div>-->

        <div class="doc-header">

            <div class="header-ar">
                دائرة القبول والتسجيل

                <div class="header-date">
                    التاريخ :
                    <span class="date-value">@dateText</span>
                </div>
            </div>

            <div class="logo-box">
                <img src="@Url.Content("~/images/aau-logo.png")"
                     alt="Al-Ahliyya Amman University"
                     class="aau-logo" />
            </div>

            <div class="header-en">
                Department of Admission<br />
                and Registration
            </div>

        </div>
        <div class="title">وثيقة قبول مبدئي</div>

        <div class="salutation">تحية طيبة وبعد ,,</div>

        <div class="para">
            يُرجــــى العلــــم أنــــه لا مانـــع لدينـــا من قبول <span class="b">@studentWord</span>
            <span class="b">@Model.StudentNameArabic</span>
            @if (!string.IsNullOrWhiteSpace(Model.NationalityText))
            {
                <span class="b">@Model.NationalityText</span>
            
                <span> الجنسية،</span>
            }
            قبولاً مبدئياً في برنامج <span class="b">@Model.DegreeText</span> (<span class="b">@Model.MajorName</span>)
            في كلية <span class="b">@Model.FacultyName</span>،
            وذلك اعتباراً من بداية <span class="b">@Model.SemesterText</span> للعـــام الجامعـــي (<span class="b">@Model.AcademicYearText</span>)،
            .شريطة إحضار الوثائق المطلوبة مصدقة حسب الأصول وأي أوراق أخرى تطلبها الجامعة 
        </div>

        @* Optional: if status is Accepted with Condition show the condition *@
   


        <div class="para" style="margin-top:16px; text-align:center;">
            و بناءا على طلب@(pronoun) أعطيت هذه الشهادة
        </div>



        <div class="payment-box">

            <div class="payment-row">
                <div class="pay-right"><b>طريقة الدفع</b></div>
                <div class="pay-center"><b>حسابات الجامعة (كتابة اسم الطالب الرباعي)</b></div>
                <div class="pay-left"></div>
            </div>

            <div class="para" style="font-size:16px; margin-top:8px;">
                البنك العربي رقم (<span class="ltr">Jo50arab1260000000126022700501</span>)
                (<span class="ltr">Arabjoax100</span>) للدينار الأردني.
            </div>

            <div class="para" style="font-size:16px;">
                البنك الأردني الكويتي رقم (<span class="ltr">Jo95jkba2400001908870013002002</span>)
                (<span class="ltr">jkbajoam</span>) للدينار الأردني.
            </div>

        </div>

        <div class="signature">
            <div class="sig-title">مدير دائرة القبول والتسجيل</div>

            <img src="@Url.Content("~/uploads/registration-director.jpg")"
                 alt="Signature"
                 class="signature-img" />

            <div class="sig-name">محمد القعقاع</div>
        </div>


        <div class="note" style="background: #e9e9e9;">
            <b>ملاحظة :</b> لا يترتب على القبول المبدئي أية أمور مالية
        </div>

    </div>
</body>
</html>
