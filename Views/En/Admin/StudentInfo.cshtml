                                class="mybtn heading15"
                                style="background-color: #751851; width: 100%; text-align: center; border: none;"
                                @(allowAction ? "" : "disabled")>
                            @(isRejected ? "✖ Rejected" : "Reject")
                        </button>

                    </form>

                </div>
            </div>

            <div class="col-lg-4"></div>
        </div>


   


    </div>
    <div class="partspacing"></div>

</main>