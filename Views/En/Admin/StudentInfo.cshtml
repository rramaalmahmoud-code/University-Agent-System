                       @*  <button type="submit" class="mybtn heading15"
                                style="background-color: #daa328; width: 100%; text-align: center; border: none;">
                            @(isAccepted
                                ? (hasCondition ? "✔ Accepted with Condition" : "✔ Accepted")
                                : "Accept")
                        </button> *@
                        <button type="submit"
                                class="mybtn heading15"
                                style="background-color: #daa328; width: 100%; text-align: center; border: none;"
