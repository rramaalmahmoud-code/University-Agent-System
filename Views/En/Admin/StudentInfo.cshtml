@*                             <a href="@Url.Action("EditStudent","En", new { studentId = @Model.studentId})" style="  color: #264C9F; z-index: 1; "><i class="fa-solid fa-pen-to-square"></i>Edit</a>

 *@
                            @if (userType != "Admin") // 👈 hide link if user is Admin
                            {
                                <a href="@Url.Action("DeleteStudent", "AdminEn", new { id = Model.studentId })"
                                   onclick="return confirm('Are you sure you want to delete this student?');"
