
@{
    Layout = "_LayoutAdmin";
}
@{
    bool isFreezed = Model.agentStatus == "Freezed";
    bool isBlocked = Model.agentStatus == "Blocked";
    bool isActive = Model.agentStatus == "Active" || string.IsNullOrEmpty(Model.agentStatus);
}

    <main>
        <div class="container-fluid padding margin">

            <div class="row">
                <div class="col-lg-12">
                    <section id="title-wrapper" style=" justify-content: End;">

                        <h1 class="sectiontitle heading7"><p style="text-align: center;"><span style="color: #252468;">AGENT INFO</span></p></h1>
                        <div class="lineright" style="display: block; background-color: #DAA328; "></div>
                    </section>


                    <div class="row g-5">
                        <div class="col-lg-3"></div>
                        <div class="col-lg-6">

                            <p class="read" style="position: relative; top: 25px; ">
                            Status: <span style="color: #daa328;">@Model.isActive</span>
                            </p>



                            <div style=" display: flex;justify-content: end;gap: 10px;padding-bottom: 10px;">

                            <a href="@Url.Action("EditAgent","AdminEn", new { agentId = @Model.agentId})" style="  color: #264C9F; z-index: 1; "><i class="fa-solid fa-pen-to-square"></i>Edit</a>
                            <a href="@Url.Action("DeleteAgent", "AdminEn", new { id = Model.agentId })"
                               onclick="return confirm('Are you sure you want to delete this agent?');"
                               style="color: #264C9F;  z-index: 1;">
                                <i class="fa-solid fa-trash"></i> Delete
                            </a>


                            </div>


                            <div class="cardcontainer">
                                <div class="card card10" style="border-top: 4px solid #252486; ">

                                    <img src="../../../images/Artboard 2Human.jpg" style=" width: 30%; margin-top: 50px;; " class="card-img-right" alt="WHED3">
                                    <div class="card-body">
                                        <div class="card-text">
                                        <h2 class="heading14">@Model.agentNameEnglish</h2>

                                            <div>
                                                <label class="normal">ID:</label>
                                                <label class="read" style="color: #daa328">@Model.nationalId</label>
                                            </div>
                                            <div>
                                                <label class="normal">Nationality:</label>
                                                <label class="normal">@Model.Nationality</label>
                                            </div>
                                            <div>
                                            <label class="normal">@Model.Country-@Model.city</label>

                                            </div>
                                            <div>
                                                <label class="normal">Phone Number:</label>
                                            <label class="normal">@Model.agentPhone</label>
                                            </div>
                                            <div class="rowspacing"></div>
                                            <div>
                                                <label class="normal">Additional Information:</label>
                                            <label class="normal">@Model.notes</label>
                                            </div>
                                            <div class="partspacing"></div>

                                            <div>
                                                <label class="read">Password:</label>
                                            <label class="read">@Model.passowrd</label>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="Emailnphone">
                                <div class="Email2">
                                <div style="font-weight: bold;" class="Emailtext2"><p>@Model.agentEmail</p></div>
                                </div>
                                <div class="phone2">
                                <div style="font-weight: bold;" class="phonetext2"><p>@Model.agentCode</p></div>
                                </div>
                            </div>

                        </div>
                        <div class="col-lg-3"></div>
                    </div>



                </div>






            </div>

        <form asp-controller="AdminEn" asp-action="UpdateAgentStatus" method="post">
            <input type="hidden" name="agentId" value="@Model.agentId" />

            <div class="row">
                <div class="col-lg-4"></div>

                <div class="col-lg-4">
                    <div class="btnwrap" style="min-width: 60%; display: flex; gap: 10px;">

                        <!-- Freeze Button -->
                        <button type="submit" name="status" value="Freezed"
                                class="mybtn heading15"
                                style="background-color: #daa328; width: 50%; text-align: center; border: none;"
                        @(isBlocked ? "disabled" : "")>
                            @(isFreezed ? "Unfreeze" : "Freeze")
                        </button>

                        <!-- Block Button -->
                        <button type="submit" name="status" value="Blocked"
                                class="mybtn heading15"
                                style="background-color: #751851; width: 50%; text-align: center; border: none;"
                        @(isFreezed ? "disabled" : "")>
                            @(isBlocked ? "Unblock" : "Block")
                        </button>
                    </div>
                </div>

                <div class="col-lg-4"></div>
            </div>
        </form>




        </div>
        <div class="partspacing"></div>

    </main>
