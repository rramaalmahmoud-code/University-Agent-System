@model University_Agent_System.Models.ViewModel.DashboardHomeViewModel
@using System
@using System.Linq

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Admin Dashboard";

    Func<string, string> statusClass = value =>
    {
        var status = (value ?? "").Trim().ToLowerInvariant();
        if (status == "approved" || status == "accepted") return "approved";
        if (status == "under review" || status == "review") return "review";
        if (status == "rejected") return "missing";
        return "pending";
    };

    Func<string, string> initials = value =>
    {
        if (string.IsNullOrWhiteSpace(value)) return "NA";
        var words = value.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])));
    };

    var criticalAlerts = Model.Notifications.Count(x => x.Type == "Critical");
    var warningAlerts = Model.Notifications.Count(x => x.Type == "Warning");
    var attentionAgents = Model.AgentStatistics.Count(x => x.HealthStatus != "Healthy");
    var topAgents = Model.AgentStatistics.OrderByDescending(x => x.ApprovalRate)
        .ThenByDescending(x => x.TotalStudents).Take(4).ToList();
    var pendingTotalPages = Math.Max(
1,
(int)Math.Ceiling(Model.PendingTotalCount / (double)Model.PageSize));

    var pendingFromPage = Math.Max(1, Model.CurrentPage - 2);
    var pendingToPage = Math.Min(pendingTotalPages, Model.CurrentPage + 2);

    var pendingFirstRow = Model.PendingTotalCount == 0
        ? 0
        : ((Model.CurrentPage - 1) * Model.PageSize) + 1;

    var pendingLastRow = Math.Min(
        Model.CurrentPage * Model.PageSize,
        Model.PendingTotalCount);
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />

<div class="admin-dashboard">
    <section class="admin-dashboard-page-head">
        <div class="admin-dashboard-title-wrap">
            <h1>ADMIN DASHBOARD</h1>
            <div class="admin-dashboard-title-line"></div>
            <p>A complete view of agents, students, applications and approvals.</p>
        </div>
        <div class="admin-dashboard-today"><i class="far fa-calendar"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
    </section>

    <main class="admin-dashboard-main">
        <form method="get"
              action="@Url.Action("Home", "AdminEn")"
              data-dashboard-filter-url="@Url.Action("Home", "AdminEn")"
              id="dashboardFilterForm"
              class="admin-dashboard-toolbar">
            <div class="admin-dashboard-search">
                <i class="fas fa-search"></i>
                <input name="search"
                       id="dashboardSearchInput"
                       value="@Model.SearchTerm"
                       type="search"
                       placeholder="Search by student name, number, major, status or agent..."
                       autocomplete="off" />
            </div>
            <select name="intake"
                    id="dashboardIntakeSelect"
                    aria-label="Academic intake">
                @if (Model.IntakeFilter == "current")
                {
                    <option value="current" selected>Current Semester</option>
                }
                else
                {
                    <option value="current">Current Semester</option>
                }
                @if (Model.IntakeFilter == "previous")
                {
                    <option value="previous" selected>Previous Semester</option>
                }
                else
                {
                    <option value="previous">Previous Semester</option>
                }
                @if (Model.IntakeFilter == "all")
                {
                    <option value="all" selected>All Semesters</option>
                }
                else
                {
                    <option value="all">All Semesters</option>
                }
            </select>
            <button class="admin-dashboard-btn admin-dashboard-btn-pink"
                    id="dashboardSearchSubmit"
                    type="submit">
                <i class="fas fa-search"></i> Search
            </button>
            <a class="admin-dashboard-btn admin-dashboard-btn-outline"
               href="@Url.Action("Home", "AdminEn", new { intake = "all" })">
                <i class="fas fa-times"></i> Clear
            </a>
            <a class="admin-dashboard-btn admin-dashboard-btn-outline"
               href="@Url.Action("StudentList", "AdminEn", new { search = Model.SearchTerm, intake = Model.IntakeFilter })">
                <i class="fas fa-filter"></i> Student List
            </a>
        </form>

        <section class="admin-dashboard-stats">
            <article class="admin-dashboard-stat navy">
                <div class="admin-dashboard-stat-icon"><i class="fas fa-user-tie"></i></div>
                <div class="admin-dashboard-stat-label">Registered Agents</div><div class="admin-dashboard-stat-value">@Model.TotalAgents</div>
                <div class="admin-dashboard-stat-foot"><i class="fas fa-check-circle"></i> Active agent records</div>
            </article>
            <article class="admin-dashboard-stat">
                <div class="admin-dashboard-stat-icon"><i class="fas fa-user-graduate"></i></div>
                <div class="admin-dashboard-stat-label">Total Students</div><div class="admin-dashboard-stat-value">@Model.TotalStudents</div>
                <div class="admin-dashboard-stat-foot"><i class="fas fa-database"></i> Current active records</div>
            </article>
            <article class="admin-dashboard-stat gold">
                <div class="admin-dashboard-stat-icon"><i class="fas fa-hourglass-half"></i></div>
                <div class="admin-dashboard-stat-label">Pending Approvals</div><div class="admin-dashboard-stat-value">@Model.PendingCount</div>
                <div class="admin-dashboard-stat-foot attention"><i class="fas fa-exclamation-triangle"></i> Requires admin review</div>
            </article>
            <article class="admin-dashboard-stat pink">
                <div class="admin-dashboard-stat-icon"><i class="fas fa-user-check"></i></div>
                <div class="admin-dashboard-stat-label">Student Confirmed</div><div class="admin-dashboard-stat-value">@Model.StudentConfirmedCount</div>
                <div class="admin-dashboard-stat-foot attention"><i class="fas fa-file-signature"></i> Confirmed by students</div>
            </article>
        </section>

        <section class="admin-dashboard-grid">
            <div class="admin-dashboard-stack">
                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-chart-bar"></i> Application Status Overview</h2>
                     
                    </div>
                    <div class="admin-dashboard-pipeline">
                        <div class="admin-dashboard-pipeline-numbers">
                            <div class="admin-dashboard-pipe-box"><strong>@Model.PendingCount</strong><span>Pending</span></div>
                            <div class="admin-dashboard-pipe-box"><strong>@Model.UnderReviewCount</strong><span>Under Review</span></div>
                            <div class="admin-dashboard-pipe-box"><strong>@Model.RejectedCount</strong><span>Rejected</span></div>
                            <div class="admin-dashboard-pipe-box"><strong>@Model.ApprovedCount</strong><span>Approved</span></div>
                        </div>
                        <div class="admin-dashboard-bar" aria-label="Application status distribution"><span></span><span></span><span></span><span></span></div>
                    </div>
                </article>

                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-history"></i> Latest Student Applications</h2>
                        <a class="admin-dashboard-view-link"
                           href="@Url.Action("StudentList", "AdminEn", new { intake = Model.IntakeFilter })">VIEW ALL APPLICATIONS</a>
                    </div>
                    <div class="admin-dashboard-table-wrap">
                        <table id="dashboardApplicationsTable" class="admin-dashboard-table">
                            <thead><tr><th>Student</th><th>Code</th><th>Major</th><th>Agent</th><th>Confirmed</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var student in Model.LatestStudents)
                                {
                                    <tr>
                                        <td><div class="admin-dashboard-person"><span class="admin-dashboard-person-mark">@initials(student.studentNameEnglish)</span>@student.studentNameEnglish</div></td>
                                        <td>@student.studentCode</td>
                                        <td>@student.Major_Name_S</td>
                                        <td>@student.agentNameEnglish</td>
                                        <td>@(student.approvedByStudent ? "Yes" : "No")</td>
                                        <td><span class="admin-dashboard-status @statusClass(student.statusEnglish)">@student.statusEnglish</span></td>
                                        <td><a class="admin-dashboard-more" href="@Url.Action("StudentInfo", "AdminEn", new { studentId = student.studentId })">Review</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="admin-dashboard-empty-message" id="dashboardEmptyMessage">No matching student or agent was found.</div>
                    </div>
                </article>

                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-star"></i> Agent Performance</h2>

                        <a class="admin-dashboard-view-link" href="@Url.Action("AgentStatistics", "AdminEn",
                                                                 new { intake = Model.IntakeFilter })">FULL PERFORMANCE REPORT</a>

                    </div>
                    <div class="admin-dashboard-table-wrap">
                        <table id="dashboardAgentsTable" class="admin-dashboard-table">
                            <thead><tr><th>Agent</th><th>Students</th><th>Pending</th><th>Approved</th><th>Rejected</th><th>Conversion</th><th>Health</th> <th>ACCOUNT STATUS</th></tr></thead>
                            <tbody>
                                @foreach (var agent in Model.AgentStatistics.Take(5))
                                {
                                    <tr>
                                        <td><div class="admin-dashboard-person"><span class="admin-dashboard-person-mark">@initials(agent.AgentName)</span>@agent.AgentName</div></td>
                                        <td>@agent.TotalStudents</td>
                                        <td>@agent.PendingCount</td>
                                        <td>@agent.ApprovedCount</td>
                                        <td>@agent.RejectedCount</td>
                                        <td><strong class="admin-dashboard-conversion">@agent.ApprovalRate.ToString("0.0")%</strong></td>
                                        <td><span class="admin-dashboard-health @agent.HealthCssClass">@agent.HealthStatus</span></td>
                                        <td>
                                            <span class="agent-account-status @agent.AccountStatusCssClass">
                                                @agent.AccountStatusDisplay
                                            </span>

                                            @if (agent.IsContractExpired)
                                            {
                                                <small class="agent-contract-ended">
                                                    Ended @agent.ContractEndDate?.ToString("dd/MM/yyyy")
                                                </small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                
                </article>
            </div>

            <aside class="admin-dashboard-stack">
                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-bell"></i> Requires Attention</h2>
                        <span class="admin-dashboard-view-link">@Model.Notifications.Count ALERTS</span>
                    </div>
                    <div class="admin-dashboard-alerts">
                        <div class="admin-dashboard-alert-item"><div class="admin-dashboard-alert-icon"><i class="fas fa-exclamation-triangle"></i></div><div class="admin-dashboard-alert-copy"><strong>Critical agent alerts</strong><span>Immediate admin review recommended</span></div><div class="admin-dashboard-alert-count">@criticalAlerts</div></div>
                        <div class="admin-dashboard-alert-item"><div class="admin-dashboard-alert-icon gold"><i class="fas fa-clock"></i></div><div class="admin-dashboard-alert-copy"><strong>Warning-level agent alerts</strong><span>Review workloads and rejection rates</span></div><div class="admin-dashboard-alert-count">@warningAlerts</div></div>
                        <div class="admin-dashboard-alert-item"><div class="admin-dashboard-alert-icon blue"><i class="fas fa-user-clock"></i></div><div class="admin-dashboard-alert-copy"><strong>Agents needing attention</strong><span>Health status is not currently healthy</span></div><div class="admin-dashboard-alert-count">@attentionAgents</div></div>
                        <div class="admin-dashboard-alert-item"><div class="admin-dashboard-alert-icon"><i class="fas fa-hourglass-half"></i></div><div class="admin-dashboard-alert-copy"><strong>Pending student requests</strong><span>Applications awaiting a decision</span></div><div class="admin-dashboard-alert-count">@Model.PendingCount</div></div>
                    </div>
                </article>

                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head"><h2 class="admin-dashboard-panel-title"><i class="fas fa-bolt"></i> Quick Actions</h2></div>
                    <div class="admin-dashboard-quick-actions">
                        <a class="admin-dashboard-quick-action" href="@Url.Action("AddAgent", "AdminEn")"><i class="fas fa-user-plus"></i>Add New Agent</a>
                        <a class="admin-dashboard-quick-action" href="#pendingRequests"><i class="fas fa-user-check"></i>Review Approvals</a>
                        <a class="admin-dashboard-quick-action" href="@Url.Action("Index", "AdmissionMajors")"><i class="fas fa-graduation-cap"></i>Manage Majors</a>
@*                         <a class="admin-dashboard-quick-action" href="@Url.Action("AddStudent", "En")"><i class="fas fa-graduation-cap"></i>Add New Student</a>

 *@  
@if (User.IsInRole("Super Admin"))
                        {
                            <a class="admin-dashboard-quick-action"
                               href="@Url.Action("AddStudent", "En")">
                                <i class="fas fa-user-plus"></i>
                                Add New Student
                            </a>
                        }
</div>
                </article>

                <article class="admin-dashboard-panel">
                    <div class="admin-dashboard-panel-head">
                        <h2 class="admin-dashboard-panel-title"><i class="fas fa-trophy"></i> Top Agents</h2>
                        <a class="admin-dashboard-view-link" href="@Url.Action("AgentStatistics", "AdminEn",new { intake = Model.IntakeFilter })">DETAILS</a>
                    </div>
                    <div class="admin-dashboard-agent-list">
                        @foreach (var agent in topAgents)
                        {
                            <div class="admin-dashboard-agent-row"><div><a href="@Url.Action("StudentList", "AdminEn", new { agentId = agent.AgentId, intake = Model.IntakeFilter })"><strong>@agent.AgentName</strong><small>@agent.TotalStudents students · @agent.ApprovalRate.ToString("0.0")% approval</small></a></div><div class="admin-dashboard-agent-score">@agent.ApprovedCount</div></div>
                        }
                    </div>
                </article>
            </aside>
        </section>

        <section class="admin-dashboard-panel admin-dashboard-pending-panel" id="pendingRequests">
            <div class="admin-dashboard-panel-head"><h2 class="admin-dashboard-panel-title"><i class="fas fa-hourglass-half"></i> Pending Requests</h2><span class="admin-dashboard-view-link">@Model.PendingTotalCount REQUESTS</span></div>
            <div class="admin-dashboard-table-wrap">
                <table class="admin-dashboard-table">
                    <thead><tr><th>Student</th><th>Code</th><th>Major</th><th>Agent</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var student in Model.PendingStudents)
                        {
                            <tr><td><div class="admin-dashboard-person"><span class="admin-dashboard-person-mark">@initials(student.studentNameEnglish)</span>@student.studentNameEnglish</div></td><td>@student.studentCode</td><td>@student.Major_Name_S</td><td>@student.agentNameEnglish</td><td><span class="admin-dashboard-status pending">@student.statusEnglish</span></td><td><a class="admin-dashboard-more" href="@Url.Action("StudentInfo", "AdminEn", new { studentId = student.studentId })">Review</a></td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (pendingTotalPages > 1)
            {
                <nav class="admin-dashboard-pagination"
                     aria-label="Pending requests pages">

                    <span class="admin-dashboard-pagination-summary">
                        Showing @pendingFirstRow-@pendingLastRow
                        of @Model.PendingTotalCount
                    </span>

                    <div class="admin-dashboard-pagination-buttons">

                        @if (Model.CurrentPage > 1)
                        {
                            <a class="admin-dashboard-page-button"
                               href="@Url.Action(
                                                                                             "Home",
                                                                                             "AdminEn",
                                                                                             new
                                                                                             {
                                                                                                 search = Model.SearchTerm,
                                                                                                 intake = Model.IntakeFilter,
                                                                                                 page = Model.CurrentPage - 1,
                                                                                                 pageSize = Model.PageSize
                                                                                             })#pendingRequests">
                        Previous
                    </a>
                                        }

                        @for (var pageNumber = pendingFromPage;
                                            pageNumber <= pendingToPage;
                                            pageNumber++)
                        {
                            if (pageNumber == Model.CurrentPage)
                            {
                                <span class="admin-dashboard-page-button active"
                                      aria-current="page">
                                    @pageNumber
                                </span>
                            }
                            else
                            {
                                <a class="admin-dashboard-page-button"
                                   href="@Url.Action(
                                                                                                         "Home",
                                                                                                         "AdminEn",
                                                                                                         new
                                                                                                         {
                                                                                                             search = Model.SearchTerm,
                                                                                                             intake = Model.IntakeFilter,
                                                                                                             page = pageNumber,
                                                                                                             pageSize = Model.PageSize
                                                                                                         })#pendingRequests">
                        @pageNumber
                    </a>
                                        }
                        }

                        @if (Model.CurrentPage < pendingTotalPages)
                        {
                            <a class="admin-dashboard-page-button"
                               href="@Url.Action(
                                                                                             "Home",
                                                                                             "AdminEn",
                                                                                             new
                                                                                             {
                                                                                                 search = Model.SearchTerm,
                                                                                                 intake = Model.IntakeFilter,
                                                                                                 page = Model.CurrentPage + 1,
                                                                                                 pageSize = Model.PageSize
                                                                                             })#pendingRequests">
                        Next
                    </a>
                                        }

                    </div>
                </nav>
            }


        </section>
    </main>
</div>

<script src="~/scripts/admin-dashboard.js" asp-append-version="true"></script>