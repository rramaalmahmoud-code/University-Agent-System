<script>
    function buildFullName() {
        const fullArabicName = document.getElementById("FullArabicName");
        const fullEnglishName = document.getElementById("FullEnglishName");
        const getInputValue = id => document.getElementById(id)?.value.trim() || "";

        if (fullArabicName) {
            fullArabicName.value = [
                getInputValue("ArabicFirstName"),
                getInputValue("ArabicFatherName"),
                getInputValue("ArabicGrandFatherName"),
                getInputValue("ArabicFamilyName")
            ].filter(Boolean).join(" ");
        }

        if (fullEnglishName) {
            fullEnglishName.value = [
                getInputValue("EnglishFirstName"),
                getInputValue("EnglishFatherName"),
                getInputValue("EnglishGrandFatherName"),
                getInputValue("EnglishFamilyName")
            ].filter(Boolean).join(" ");
        }
    }
    document.querySelectorAll("input").forEach(i => i.addEventListener("blur", buildFullName));
    document.querySelector('form[action="AddStudent"]')?.addEventListener("submit", buildFullName);
</script>

<script>
    function filterAgent() {
        const input = document.getElementById("agentSearch");
        const list = document.getElementById("agentOptions");

        if (!input || !list) {
            return;
        }

        const filter = input.value.toUpperCase();
        const items = list.getElementsByTagName("li");

        list.style.display = input.value.length > 0 ? "block" : "none";

        for (let i = 0; i < items.length; i++) {
            const text = items[i].textContent || items[i].innerText;
            items[i].style.display =
                text.toUpperCase().indexOf(filter) > -1 ? "" : "none";
        }
    }


        document.addEventListener('DOMContentLoaded', function () {

               const agentOptions = document.getElementById('agentOptions');
               const agentSearch = document.getElementById('agentSearch');
               const selectedAgentId = document.getElementById('selectedAgentId');

               if (!agentOptions || !agentSearch || !selectedAgentId) {
                   return;
               }

               agentOptions.addEventListener('click', function (event) {
                   if (event.target && event.target.matches('.agent-item')) {
                       var agentName = event.target.innerText;
                       var agentId = event.target.getAttribute('data-id');


                       agentSearch.value = agentName;
                       selectedAgentId.value = agentId;


                       agentOptions.style.display = "none";
                   }
               });


               document.addEventListener('click', function (event) {
                   const isClickInside = agentSearch.contains(event.target) ||
                                       agentOptions.contains(event.target);
                   if (!isClickInside) {
                       agentOptions.style.display = "none";
                   }
               });
           });



    function toggleUploads() {
        const transferCheckbox = document.getElementById("TransferCheckbox");
        const diplomaCheckbox = document.getElementById("DiplomaCheckbox");
        const transferDiv = document.getElementById("transferUploadDiv");
        const diplomaDiv = document.getElementById("diplomaUploadDiv");
        const transferInput = document.getElementById("transferReport");
        const diplomaInput = document.getElementById("diplomaReportInput");

        if (transferCheckbox && transferDiv && transferInput) {
            transferDiv.style.display = transferCheckbox.checked
                ? "block"
                : "none";

            if (transferCheckbox.checked) {
                transferInput.setAttribute("required", "required");
            } else {
                transferInput.removeAttribute("required");
            }
        }

           if (diplomaCheckbox && diplomaDiv) {
        diplomaDiv.style.display =
            diplomaCheckbox.checked ? "block" : "none";

        if (diplomaInput) {
            diplomaInput.required = diplomaCheckbox.checked;
        }
    }
    }

    function filterCountry(event) {
        const input = event?.target;

        if (!input) {
            return;
        }

        const listId = input.getAttribute("data-list");
        const list = document.getElementById(listId);

        if (!list) {
            return;
        }

        const filter = input.value.toUpperCase();
        const items = list.getElementsByTagName("li");

        list.style.display = input.value.length > 0 ? "block" : "none";

        for (let i = 0; i < items.length; i++) {
            const text = items[i].textContent || items[i].innerText;
            items[i].style.display =
                text.toUpperCase().indexOf(filter) > -1 ? "" : "none";
        }
    }

    const bilingualLookupAliases = {
        countries: @Html.Raw(JsonConvert.SerializeObject(
                        Model.Countries.Select(item => new
                        {
                                id = item.countryId,
                                arabicName = item.countryArabic,
                                englishName = item.countryEnglish
                        })
                )),
        nationalities: @Html.Raw(JsonConvert.SerializeObject(
                        Model.Nationalities.Select(item => new
                        {
                                id = item.nationalityId,
                                arabicName = item.nationalityArabic,
                                englishName = item.nationalityEnglish
                        })
                )),
        agents: @Html.Raw(JsonConvert.SerializeObject(
                        Model.Agents.Select(item => new
                        {
                                id = item.agentId,
                                arabicName = item.agentNameArabic,
                                englishName = item.agentNameEnglish
                        })
                ))
    };

    function normalizeLookupText(value) {
        return (value || "")
            .trim()
            .replace(/\s+/g, " ")
            .toLocaleLowerCase();
    }

    function selectExactListMatch(input, showValidationMessage = false) {
        const list = document.getElementById(input.dataset.list);
        const hiddenInput = document.getElementById(input.dataset.target);

        if (!list || !hiddenInput) {
            return true;
        }

        const typedValue = normalizeLookupText(input.value);
        const options = Array.from(list.querySelectorAll("li[data-id]"));
        const exactOption = options.find(option =>
            normalizeLookupText(option.textContent) === typedValue
        );

        const aliasGroup = list.id === "nationalityOptions"
            ? bilingualLookupAliases.nationalities
            : list.id === "agentOptions"
                ? bilingualLookupAliases.agents
                : bilingualLookupAliases.countries;

        const exactAlias = (aliasGroup || []).find(item =>
            normalizeLookupText(item.arabicName) === typedValue ||
            normalizeLookupText(item.englishName) === typedValue
        );

        const matchedId = exactOption?.dataset.id ?? exactAlias?.id;

        if (matchedId !== undefined && matchedId !== null && matchedId !== "") {
            input.value = input.value.trim();
            hiddenInput.value = matchedId;
            input.setCustomValidity("");
            list.style.display = "none";
            return true;
        }

        hiddenInput.value = "";

        if (showValidationMessage) {
            input.setCustomValidity(
                typedValue
                    ? "Please enter a valid value from the list."
                    : "Please select a value from the list."
            );
        } else {
            input.setCustomValidity("");
        }

        return false;
    }

      document.addEventListener('DOMContentLoaded', function () {


        document.querySelectorAll('input[data-list]').forEach(function(input) {
            const listId = input.getAttribute('data-list');
            const list = document.getElementById(listId);

            if (!list) {
                return;
            }

            input.addEventListener('input', function () {
                const hiddenInput = document.getElementById(input.dataset.target);

                if (hiddenInput) {
                    hiddenInput.value = "";
                }

                input.setCustomValidity("");
            });


            input.addEventListener('keyup', function () {
                const filter = input.value.toUpperCase();
                const items = list.getElementsByTagName('li');

                list.style.display = input.value.length > 0 ? 'block' : 'none';

                for (let i = 0; i < items.length; i++) {
                    const txtValue = items[i].textContent || items[i].innerText;
                    items[i].style.display = txtValue.toUpperCase().indexOf(filter) > -1 ? '' : 'none';
                }
            });


            input.addEventListener('click', function(e) {
                e.stopPropagation();
                if (input.value.length > 0) {
                    list.style.display = 'block';
                }
            });

            input.addEventListener('blur', function () {
                window.setTimeout(function () {
                    selectExactListMatch(input);
                }, 150);
            });


            list.addEventListener('click', function(e) {
                const selectedItem = e.target.closest('li[data-id]');

                if (selectedItem && list.contains(selectedItem)) {
                    e.stopPropagation();
                    input.value = selectedItem.textContent.trim();
                    const hiddenInputId = input.getAttribute('data-target');
                    if (hiddenInputId) {
                        document.getElementById(hiddenInputId).value = selectedItem.getAttribute('data-id');
                    }
                    input.setCustomValidity("");
                    list.style.display = 'none';
                }
            });
        });

        const addStudentForm = document.querySelector('form[action="AddStudent"]');

        addStudentForm?.addEventListener('submit', function (event) {
            const visibleSearchInputs = Array.from(
                addStudentForm.querySelectorAll('input[data-list][data-target]')
            ).filter(input => input.offsetParent !== null);

            const invalidInput = visibleSearchInputs.find(input =>
                !selectExactListMatch(input, true)
            );

            if (invalidInput) {
                event.preventDefault();
                invalidInput.reportValidity();
                invalidInput.focus();
            }
        });


        document.addEventListener('click', function () {
            document.querySelectorAll('ul.list-group').forEach(function(list) {
                list.style.display = 'none';
            });
        });
    });


    (() => {
        const degreeDropdown = document.getElementById("dropdownDegree");
        const facultyDropdown = document.getElementById("dropdownFaculty");
        const programDropdown = document.getElementById("dropdownProgram");
        const selectedDegreeInput = document.getElementById("selectedDegreeId");
        const selectedFacultyInput = document.getElementById("selectedFacultyId");
        const selectedAdmissionMajorInput = document.getElementById("selectedAdmissionMajorId");
        const selectedProgramInput = document.getElementById("selectedProgramId");
        const discountInput = document.getElementById("discount");
        const discountHiddenInput = document.getElementById("discountHidden");
        const semesterInput = document.querySelector('input[name="semesterId"]');
        const getMajorsUrl = '@Url.Action("GetMajors", "AdmissionCatalog")';

        if (!degreeDropdown || !facultyDropdown || !programDropdown ||
            !selectedDegreeInput || !selectedFacultyInput ||
            !selectedAdmissionMajorInput || !selectedProgramInput ||
            !discountInput || !semesterInput) {
            return;
        }

        const getValue = (item, ...keys) => {
            for (const key of keys) {
                if (item[key] !== undefined && item[key] !== null) {
                    return item[key];
                }
            }

            return null;
        };

        const clearMajor = () => {
            programDropdown.innerHTML = '<option value="">Select Program</option>';
            selectedAdmissionMajorInput.value = "";
            selectedProgramInput.value = "";
            discountInput.value = "";

            if (discountHiddenInput) {
                discountHiddenInput.value = "";
            }
        };

        const applySelectedMajor = () => {
            const selectedOption = programDropdown.options[programDropdown.selectedIndex];
            const hasSelection = selectedOption && programDropdown.value !== "";
            const discount = hasSelection
                ? (selectedOption.dataset.discountPercentage || "0")
                : "";

            selectedAdmissionMajorInput.value = hasSelection
                ? programDropdown.value
                : "";


            selectedProgramInput.value = hasSelection
                ? (selectedOption.dataset.oracleMajorNo || "")
                : "";

            discountInput.value = discount;

            if (discountHiddenInput) {
                discountHiddenInput.value = discount;
            }
        };

        const loadMajors = async (selectedAdmissionMajorId = "") => {
            clearMajor();

            selectedDegreeInput.value = degreeDropdown.value === "0"
                ? ""
                : degreeDropdown.value;

            selectedFacultyInput.value = facultyDropdown.value === "0"
                ? ""
                : facultyDropdown.value;

            if (!selectedDegreeInput.value ||
                !selectedFacultyInput.value ||
                !semesterInput.value) {
                return;
            }

            programDropdown.disabled = true;

            try {
                const query = new URLSearchParams({
                    facultyNo: selectedFacultyInput.value,
                    degreeId: selectedDegreeInput.value,
                    semesterId: semesterInput.value
                });

                if (selectedAdmissionMajorId) {
                    query.set("selectedAdmissionMajorId", selectedAdmissionMajorId);
                }

                const response = await fetch(`${getMajorsUrl}?${query}`, {
                    headers: { "Accept": "application/json" }
                });

                if (!response.ok) {
                    throw new Error("Unable to load programs.");
                }

                const responseBody = await response.json();
                const majors = Array.isArray(responseBody)
                    ? responseBody
                    : (responseBody.data || []);

                majors.forEach(major => {
                    const admissionMajorId = getValue(
                        major,
                        "admissionMajorId",
                        "AdmissionMajorId"
                    );

                    if (admissionMajorId === null) {
                        return;
                    }

                    const option = document.createElement("option");
                    option.value = admissionMajorId;
                    option.textContent = getValue(
                        major,
                        "majorNameEnglish",
                        "MajorNameEnglish",
                        "majorNameEn",
                        "MajorNameEn",
                        "displayName",
                        "DisplayName",
                        "majorName",
                        "MajorName"
                    ) || "";

                    option.dataset.oracleMajorNo = getValue(
                        major,
                        "oracleMajorNo",
                        "OracleMajorNo",
                        "majorNo",
                        "MajorNo"
                    ) || "";

                    option.dataset.discountPercentage = getValue(
                        major,
                        "discountPercentage",
                        "DiscountPercentage",
                        "discount",
                        "Discount"
                    ) ?? 0;

                    option.selected = String(admissionMajorId) ===
                        String(selectedAdmissionMajorId);

                    programDropdown.appendChild(option);
                });

                applySelectedMajor();
            }
            catch (error) {
                clearMajor();
                programDropdown.innerHTML =
                    '<option value="">Unable to load programs</option>';
                console.error(error);
            }
            finally {
                programDropdown.disabled = false;
            }
        };

        programDropdown.addEventListener("change", applySelectedMajor);
        degreeDropdown.addEventListener("change", () => loadMajors());
        facultyDropdown.addEventListener("change", () => loadMajors());

        const initiallySelectedMajor =
            programDropdown.dataset.selected ||
            selectedAdmissionMajorInput.value ||
            "";

        loadMajors(initiallySelectedMajor);
    })();
    function filterNationality() {
        const input = document.getElementById("recivedGroup");
        const list = document.getElementById("nationalityOptions");

        if (!input || !list) {
            return;
        }

        const filter = input.value.toUpperCase();
        const items = list.getElementsByTagName("li");

        list.style.display = input.value.length > 0 ? "block" : "none";

        for (let i = 0; i < items.length; i++) {
            const text = items[i].textContent || items[i].innerText;
            items[i].style.display =
                text.toUpperCase().indexOf(filter) > -1 ? "" : "none";
        }
    }
