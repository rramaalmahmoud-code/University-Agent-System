@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@model StudentViewModel

@functions {
    public string GetUserType()
    {
        var jwt = Context.Request.Cookies["jwt"];
        if (string.IsNullOrEmpty(jwt)) return null;

        var handler = new JwtSecurityTokenHandler();
        var token = handler.ReadJwtToken(jwt);
        var typeClaim = token.Claims.FirstOrDefault(c => c.Type == "userType");
        return typeClaim?.Value;
    }
}

@{
    string userType = GetUserType();
    Layout = (userType == "Super Admin" || userType == "Admin") ? "_LayoutAdmin" : "_Layout";

    string pathPrefix = userType == "Agent" ? "/En/StudentInfo/" : "/En/Admin/StudentInfo/";
    var nationalities = (List<University_Agent_System.Models.nationality>)Model.Nationalities;
    var countries = (List<University_Agent_System.Models.country>)Model.Countries;
    var agents = (List<University_Agent_System.Models.agent>)Model.Agents;
    var selectedNationality = nationalities?.FirstOrDefault(n => n.nationalityId == Model.nationalityId)?.nationalityEnglish;
    var selectedCountry = countries?.FirstOrDefault(c => c.countryId == Model.countryId)?.countryEnglish;
    var selectedCountry0 = countries?.FirstOrDefault(c => c.countryId == Model.countryId0)?.countryEnglish;
    var selectedCountry1 = countries?.FirstOrDefault(c => c.countryId == Model.countryId1)?.countryEnglish;
    var selectedCountry2 = countries?.FirstOrDefault(c => c.countryId == Model.countryId2)?.countryEnglish;
    var selectedCountry3 = countries?.FirstOrDefault(c => c.countryId == Model.countryId3)?.countryEnglish;
    var faculties = Model.Faculties as List<University_Agent_System.Models.Oracle.FacultyWithProgramsViewModel>;
    var selectedAgent = agents?.FirstOrDefault(a => a.agentId == Model.agentId)?.agentNameEnglish;
    // string maleSelected = Model.studentGender == 1 ? "selected" : "";
    // string femaleSelected = Model.studentGender == 0 ? "selected" : "";
}
@{
    var selectedGender = Model.studentGender;
}
